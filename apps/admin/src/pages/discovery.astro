---
import { readRuntimeConfig } from "@newsportal/config";
import DiscoveryCandidatesTab from "../components/discovery/DiscoveryCandidatesTab.astro";
import DiscoveryClassesTab from "../components/discovery/DiscoveryClassesTab.astro";
import DiscoveryControlPlaneHero from "../components/discovery/DiscoveryControlPlaneHero.astro";
import DiscoveryDashboardTab from "../components/discovery/DiscoveryDashboardTab.astro";
import DiscoveryFeedbackTab from "../components/discovery/DiscoveryFeedbackTab.astro";
import DiscoveryHypothesesTab from "../components/discovery/DiscoveryHypothesesTab.astro";
import DiscoveryMissionsTab from "../components/discovery/DiscoveryMissionsTab.astro";
import DiscoveryProfilesTab from "../components/discovery/DiscoveryProfilesTab.astro";
import DiscoveryPortfolioTab from "../components/discovery/DiscoveryPortfolioTab.astro";
import DiscoveryRecallTab from "../components/discovery/DiscoveryRecallTab.astro";
import DiscoverySourcesTab from "../components/discovery/DiscoverySourcesTab.astro";
import AdminShell from "../layouts/AdminShell.astro";
import { resolveAdminSession } from "../lib/server/auth";
import {
  buildAdminSignInPath,
  readFlash,
  resolveAdminCurrentPath,
} from "../lib/server/browser-flow";
import {
  buildDiscoveryPageLinks,
  buildDiscoveryPageViewModel,
} from "../lib/server/discovery-page-view-model";

export const prerender = false;

const runtimeConfig = readRuntimeConfig(process.env, { defaultAppBaseUrl: "http://127.0.0.1:4322/" });
const session = await resolveAdminSession(Astro.request);
if (!session) {
  return Astro.redirect(
    buildAdminSignInPath(Astro.request, resolveAdminCurrentPath(Astro.request))
  );
}

const flash = readFlash(Astro.url);
const tab = Astro.url.searchParams.get("tab") ?? "dashboard";
const {
  appPath,
  bffPath,
  currentPath,
  pagePaths,
  resolveMissionScopedHref,
  resolvePageHref,
  resolveSelectionHref,
  tabs,
} = buildDiscoveryPageLinks({
  request: Astro.request,
  url: Astro.url,
  tab,
});
const {
  activeLlmModel,
  activeSearchProvider,
  attachableProfiles,
  candidateItems,
  candidates,
  classItems,
  classes,
  costItems,
  costs,
  feedback,
  feedbackItems,
  hypothesisItems,
  hypotheses,
  missionItems,
  missions,
  monthToDateCostUsd,
  monthlyBudgetCents,
  monthlyQuotaReached,
  operatorSummary,
  portfolioGaps,
  portfolioSnapshot,
  portfolioSummary,
  profileItems,
  profiles,
  rankedSources,
  recallCandidateItems,
  recallCandidates,
  recallMissionItems,
  recallMissions,
  remainingMonthlyBudgetCents,
  selectedCandidate,
  selectedCandidateId,
  selectedMissionId,
  selectedMissionWorkspace,
  selectedMissionWorkspaceId,
  selectedSourceProfile,
  selectedSourceProfileId,
  sourceProfileItems,
  sourceProfiles,
  sourceScoreByProfileId,
  summary,
  totalCostUsd,
} = await buildDiscoveryPageViewModel({
  runtimeConfig,
  url: Astro.url,
  fetchImpl: fetch,
});

const candidateSelectionHrefById = Object.fromEntries(
  candidateItems
    .map((candidate) => String(candidate.candidate_id ?? ""))
    .filter(Boolean)
    .map((candidateId) => [
      candidateId,
      resolveSelectionHref("candidates", { selectedCandidateId: candidateId }),
    ])
);
const sourceSelectionHrefById = Object.fromEntries(
  sourceProfileItems
    .map((profile) => String(profile.source_profile_id ?? ""))
    .filter(Boolean)
    .map((profileId) => [
      profileId,
      resolveSelectionHref("sources", { selectedSourceProfileId: profileId }),
    ])
);
const missionHrefById = Object.fromEntries(
  missionItems
    .map((mission) => String(mission.mission_id ?? ""))
    .filter(Boolean)
    .map((missionId) => [missionId, resolveMissionScopedHref(missionId)])
);
const missionSelectionHrefById = Object.fromEntries(
  missionItems
    .map((mission) => String(mission.mission_id ?? ""))
    .filter(Boolean)
    .map((missionId) => [
      missionId,
      resolveSelectionHref("missions", { selectedMissionId: missionId }),
    ])
);
const selectedMissionHref = selectedMissionId
  ? resolveMissionScopedHref(selectedMissionId)
  : "";
---

<AdminShell title="Discovery — Admin" session={session} flash={flash} activeNav="discovery">
  <Fragment slot="header-title">
    <nav class="flex items-center gap-1 text-sm text-muted-foreground">
      <a href={pagePaths.dashboard} class="hover:text-foreground">Dashboard</a>
      <span>/</span>
      <span class="text-foreground font-medium">Discovery</span>
    </nav>
  </Fragment>

  <Fragment slot="header-actions">
    <a href={appPath("/channels")} class="inline-flex h-9 items-center justify-center rounded-md border border-input px-3 text-sm font-medium transition-colors hover:bg-accent">
      View channels
    </a>
  </Fragment>

  <div class="space-y-6">
    <DiscoveryControlPlaneHero
      activeLlmModel={activeLlmModel}
      activeSearchProvider={activeSearchProvider}
      defaultCron={runtimeConfig.discoveryCron}
      monthToDateCostUsd={monthToDateCostUsd}
      monthlyBudgetCents={monthlyBudgetCents}
      monthlyQuotaReached={monthlyQuotaReached}
      operatorSummary={operatorSummary}
      remainingMonthlyBudgetCents={remainingMonthlyBudgetCents}
      summary={summary}
      tab={tab}
      tabs={tabs}
    />

    {(tab === "dashboard" || !tab) && (
      <DiscoveryDashboardTab
        costItems={costItems}
        costs={costs}
        operatorSummary={operatorSummary}
        totalCostUsd={totalCostUsd}
      />
    )}

    {tab === "profiles" && (
      <DiscoveryProfilesTab
        bffPath={bffPath}
        candidateItems={candidateItems}
        currentPath={currentPath}
        missionItems={missionItems}
        nextHref={resolvePageHref("profilePage", profiles.page + 1)}
        operatorSummary={operatorSummary}
        prevHref={resolvePageHref("profilePage", profiles.page - 1)}
        profileItems={profileItems}
        profiles={profiles}
        recallMissionItems={recallMissionItems}
      />
    )}

    {tab === "missions" && (
      <DiscoveryMissionsTab
        attachableProfiles={attachableProfiles}
        bffPath={bffPath}
        currentPath={currentPath}
        missionItems={missionItems}
        missionPortfolioHrefById={missionHrefById}
        missionSelectionHrefById={missionSelectionHrefById}
        missions={missions}
        monthlyQuotaReached={monthlyQuotaReached}
        nextHref={resolvePageHref("missionPage", missions.page + 1)}
        prevHref={resolvePageHref("missionPage", missions.page - 1)}
        selectedMissionWorkspace={selectedMissionWorkspace}
        selectedMissionWorkspaceId={selectedMissionWorkspaceId}
        summary={summary}
      />
    )}

    {tab === "recall" && (
      <DiscoveryRecallTab
        attachableProfiles={attachableProfiles}
        bffPath={bffPath}
        currentPath={currentPath}
        operatorSummary={operatorSummary}
        recallCandidateItems={recallCandidateItems}
        recallCandidateNextHref={resolvePageHref("recallCandidatePage", recallCandidates.page + 1)}
        recallCandidatePrevHref={resolvePageHref("recallCandidatePage", recallCandidates.page - 1)}
        recallCandidates={recallCandidates}
        recallMissionItems={recallMissionItems}
        recallMissionNextHref={resolvePageHref("recallMissionPage", recallMissions.page + 1)}
        recallMissionPrevHref={resolvePageHref("recallMissionPage", recallMissions.page - 1)}
        recallMissions={recallMissions}
      />
    )}

    {tab === "classes" && (
      <DiscoveryClassesTab
        bffPath={bffPath}
        classItems={classItems}
        classes={classes}
        currentPath={currentPath}
        nextHref={resolvePageHref("classPage", classes.page + 1)}
        prevHref={resolvePageHref("classPage", classes.page - 1)}
      />
    )}

    {tab === "candidates" && (
      <DiscoveryCandidatesTab
        bffPath={bffPath}
        candidateItems={candidateItems}
        candidates={candidates}
        currentPath={currentPath}
        nextHref={resolvePageHref("candidatePage", candidates.page + 1)}
        prevHref={resolvePageHref("candidatePage", candidates.page - 1)}
        selectedCandidate={selectedCandidate}
        selectedCandidateId={selectedCandidateId}
        selectionHrefByCandidateId={candidateSelectionHrefById}
      />
    )}

    {tab === "hypotheses" && (
      <DiscoveryHypothesesTab
        hypotheses={hypotheses}
        hypothesisItems={hypothesisItems}
        nextHref={resolvePageHref("hypothesisPage", hypotheses.page + 1)}
        prevHref={resolvePageHref("hypothesisPage", hypotheses.page - 1)}
      />
    )}

    {tab === "sources" && (
      <DiscoverySourcesTab
        currentMissionHref={selectedMissionHref}
        nextHref={resolvePageHref("sourcePage", sourceProfiles.page + 1)}
        prevHref={resolvePageHref("sourcePage", sourceProfiles.page - 1)}
        selectedMissionId={selectedMissionId}
        selectedSourceProfile={selectedSourceProfile}
        selectedSourceProfileId={selectedSourceProfileId}
        sourceProfileItems={sourceProfileItems}
        sourceProfiles={sourceProfiles}
        sourceScoreByProfileId={sourceScoreByProfileId}
        sourceSelectionHrefById={sourceSelectionHrefById}
      />
    )}

    {tab === "portfolio" && (
      <DiscoveryPortfolioTab
        bffPath={bffPath}
        currentPath={currentPath}
        missionHrefById={missionHrefById}
        missionItems={missionItems}
        portfolioGaps={portfolioGaps}
        portfolioSnapshot={portfolioSnapshot}
        portfolioSummary={portfolioSummary}
        rankedSources={rankedSources}
        selectedMissionId={selectedMissionId}
      />
    )}

    {tab === "feedback" && (
      <DiscoveryFeedbackTab
        bffPath={bffPath}
        currentPath={currentPath}
        feedback={feedback}
        feedbackItems={feedbackItems}
        nextHref={resolvePageHref("feedbackPage", feedback.page + 1)}
        prevHref={resolvePageHref("feedbackPage", feedback.page - 1)}
        selectedMissionId={selectedMissionId}
      />
    )}
  </div>

  <script is:inline>
    (() => {
      const interactiveSelector = [
        "a",
        "button",
        "input",
        "select",
        "textarea",
        "label",
        "[role='button']",
        "[role='link']",
        "[data-admin-pane-open-link]",
      ].join(",");

      const openPaneState = (paneId) => {
        try {
          window.localStorage.setItem(`newsportal-admin-pane:${paneId}:state`, "open");
        } catch {
          return;
        }
      };

      const rows = document.querySelectorAll("[data-discovery-row-href][data-discovery-row-pane]");
      rows.forEach((row) => {
        const href = row.getAttribute("data-discovery-row-href");
        const paneId = row.getAttribute("data-discovery-row-pane");
        if (!href || !paneId) {
          return;
        }

        const navigate = () => {
          openPaneState(paneId);
          window.location.href = href;
        };

        row.addEventListener("click", (event) => {
          const target = event.target;
          if (!(target instanceof Element)) {
            navigate();
            return;
          }
          if (target.closest(interactiveSelector)) {
            return;
          }
          navigate();
        });

        row.addEventListener("keydown", (event) => {
          if (event.key !== "Enter" && event.key !== " ") {
            return;
          }
          const target = event.target;
          if (target instanceof Element && target.closest(interactiveSelector) !== row && target !== row) {
            return;
          }
          event.preventDefault();
          navigate();
        });
      });
    })();
  </script>
</AdminShell>

---
import { readRuntimeConfig } from "@newsportal/config";
import { createNewsPortalSdk } from "@newsportal/sdk";
import AdminShell from "../../../layouts/AdminShell.astro";
import { resolveAdminSession } from "../../../lib/server/auth";
import {
  buildAdminSignInPath,
  readFlash,
  resolveAdminCurrentPath,
} from "../../../lib/server/browser-flow";

export const prerender = false;

const session = await resolveAdminSession(Astro.request);
if (!session) {
  return Astro.redirect(
    buildAdminSignInPath(Astro.request, resolveAdminCurrentPath(Astro.request))
  );
}

const resource = String(Astro.params.resource ?? "");
const recordId = String(Astro.params.recordId ?? "");
const runtimeConfig = readRuntimeConfig(process.env, {
  defaultAppBaseUrl: "http://127.0.0.1:4322/",
});
const sdk = createNewsPortalSdk({ baseUrl: runtimeConfig.apiBaseUrl, fetchImpl: fetch });
const flash = readFlash(Astro.url);
const record = await sdk.getDiscoveryVNextRecord<Record<string, unknown>>(resource, recordId);
const pretty = JSON.stringify(record, null, 2);

function objectValue(value: unknown): Record<string, unknown> {
  return value != null && typeof value === "object" && !Array.isArray(value)
    ? value as Record<string, unknown>
    : {};
}

function text(value: unknown, fallback = "n/a"): string {
  if (Array.isArray(value)) {
    return value.length > 0 ? value.map((entry) => text(entry, "")).filter(Boolean).join(", ") : fallback;
  }
  if (value != null && typeof value === "object") {
    const serialized = JSON.stringify(value);
    return serialized === "{}" || serialized === "[]" ? fallback : serialized;
  }
  const normalized = String(value ?? "").trim();
  return normalized || fallback;
}

const payload = objectValue(record.payload_json ?? record.payload);
const scoreComponents = objectValue(payload.scoreComponents);
const risk = objectValue(payload.risk ?? record.risk_json);
---

<AdminShell title="Discovery vNext — Detail" session={session} flash={flash} activeNav="discovery">
  <Fragment slot="header-title">
    <nav class="flex items-center gap-1 text-sm text-muted-foreground">
      <a href="/" class="hover:text-foreground">Dashboard</a>
      <span>/</span>
      <a href="/discovery" class="hover:text-foreground">Discovery vNext</a>
      <span>/</span>
      <span class="font-medium text-foreground">{resource}</span>
    </nav>
  </Fragment>

  <div class="space-y-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-normal">{resource}</h1>
      <p class="mt-1 break-all text-sm text-muted-foreground">{recordId}</p>
    </div>

    {(resource === "artifacts" || resource === "source-inventory") && (
      <section class="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
        <div class="rounded-md border bg-card p-3">
          <div class="text-xs font-medium uppercase text-muted-foreground">Source voice</div>
          <div class="mt-2 break-words text-sm font-medium">{text(payload.sourceVoice ?? record.source_voice)}</div>
        </div>
        <div class="rounded-md border bg-card p-3">
          <div class="text-xs font-medium uppercase text-muted-foreground">Freshness</div>
          <div class="mt-2 break-words text-sm font-medium">{text(payload.artifactFreshnessKind ?? record.artifact_freshness_kind)}</div>
        </div>
        <div class="rounded-md border bg-card p-3">
          <div class="text-xs font-medium uppercase text-muted-foreground">Signal mode</div>
          <div class="mt-2 break-words text-sm font-medium">{text(payload.signalProductionMode ?? record.signal_production_mode)}</div>
        </div>
        <div class="rounded-md border bg-card p-3">
          <div class="text-xs font-medium uppercase text-muted-foreground">Routing confidence</div>
          <div class="mt-2 break-words text-sm font-medium">{text(payload.routingConfidence ?? record.source_role_confidence)}</div>
        </div>
      </section>
    )}

    <section class="grid gap-3 md:grid-cols-2 xl:grid-cols-4">
      <div class="rounded-md border bg-card p-3">
        <div class="text-xs font-medium uppercase text-muted-foreground">Origin run</div>
        <div class="mt-2 break-words text-sm font-medium">{text(record.vnext_run_id ?? record.run_id)}</div>
      </div>
      <div class="rounded-md border bg-card p-3">
        <div class="text-xs font-medium uppercase text-muted-foreground">Interest</div>
        <div class="mt-2 break-words text-sm font-medium">{text(record.interest_id)}</div>
      </div>
      <div class="rounded-md border bg-card p-3">
        <div class="text-xs font-medium uppercase text-muted-foreground">Candidate</div>
        <div class="mt-2 break-words text-sm font-medium">{text(record.candidate_id)}</div>
      </div>
      <div class="rounded-md border bg-card p-3">
        <div class="text-xs font-medium uppercase text-muted-foreground">Parents</div>
        <div class="mt-2 break-words text-sm font-medium">{text(record.parent_artifact_ids)}</div>
      </div>
    </section>

    {Object.keys(payload).length > 0 && (
      <section class="grid gap-4 xl:grid-cols-2">
        <div class="rounded-md border bg-card p-4">
          <h2 class="text-base font-semibold tracking-normal">Source Understanding</h2>
          <dl class="mt-3 grid gap-2 text-sm">
            <div><dt class="text-muted-foreground">Reason to keep</dt><dd>{text(payload.reasonToKeep ?? record.inventory_reason)}</dd></div>
            <div><dt class="text-muted-foreground">Reason not to auto-register</dt><dd>{text(payload.reasonNotToAutoRegister)}</dd></div>
            <div><dt class="text-muted-foreground">Can produce signals</dt><dd class="break-words">{text(payload.canProduceSignals)}</dd></div>
            <div><dt class="text-muted-foreground">Not expected to produce</dt><dd class="break-words">{text(payload.notExpectedToProduce)}</dd></div>
          </dl>
        </div>
        <div class="rounded-md border bg-card p-4">
          <h2 class="text-base font-semibold tracking-normal">Routing / Risk</h2>
          <dl class="mt-3 grid gap-2 text-sm">
            <div><dt class="text-muted-foreground">Decision</dt><dd>{text(payload.decision ?? record.current_state)}</dd></div>
            <div><dt class="text-muted-foreground">Policy</dt><dd>{text(payload.policyVersion)}</dd></div>
            <div><dt class="text-muted-foreground">Score components</dt><dd class="break-words">{text(scoreComponents)}</dd></div>
            <div><dt class="text-muted-foreground">Risk</dt><dd class="break-words">{text(risk)}</dd></div>
            <div><dt class="text-muted-foreground">Actions</dt><dd class="break-words">{text(payload.actions)}</dd></div>
          </dl>
        </div>
      </section>
    )}

    <pre class="overflow-x-auto rounded-md border bg-card p-4 text-xs leading-relaxed">{pretty}</pre>
  </div>
</AdminShell>

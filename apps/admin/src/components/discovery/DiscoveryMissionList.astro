---
import { PaginationNav } from "@newsportal/ui";

import {
  asStringList,
  fmtMoney,
  type DiscoveryPagedRecord,
  type DiscoveryRecord,
} from "../../lib/server/discovery-view-model";

type Props = {
  missionItems: DiscoveryRecord[];
  missionPortfolioHrefById: Record<string, string>;
  missionSelectionHrefById: Record<string, string>;
  missions: DiscoveryPagedRecord;
  nextHref: string;
  prevHref: string;
  selectedMissionWorkspaceId: string;
};

const {
  missionItems,
  missionPortfolioHrefById,
  missionSelectionHrefById,
  missions,
  nextHref,
  prevHref,
  selectedMissionWorkspaceId,
} = Astro.props as Props;
---

<section class="rounded-2xl border border-border bg-card shadow-sm overflow-hidden">
  <div class="border-b border-border px-5 py-4">
    <h2 class="text-base font-semibold">Missions</h2>
    <p class="mt-1 text-sm text-muted-foreground">{missions.total} mission{missions.total === 1 ? "" : "s"} total</p>
  </div>
  <div class="divide-y divide-border">
    {missionItems.length === 0 ? (
      <p class="px-5 py-8 text-sm text-muted-foreground">No adaptive discovery missions yet. Create one to start graph-first discovery planning.</p>
    ) : missionItems.map((mission) => {
      const missionId = String(mission.mission_id ?? "");
      const isSelected = missionId === selectedMissionWorkspaceId;
      return (
        <article
          class:list={["px-5 py-4 transition-colors", isSelected && "bg-muted/20"]}
          data-discovery-row-href={(missionSelectionHrefById[missionId] ?? "#")}
          data-discovery-row-pane="discovery-missions"
          role="link"
          tabindex="0"
        >
          <div class="flex flex-col gap-3 xl:flex-row xl:items-start xl:justify-between">
            <div class="space-y-1.5">
              <div class="flex flex-wrap items-center gap-2">
                <a
                  href={(missionSelectionHrefById[missionId] ?? "#")}
                  data-admin-pane-open-link="discovery-missions"
                  class="text-sm font-semibold hover:text-primary"
                >
                  {String(mission.title ?? "Untitled mission")}
                </a>
                <span class="inline-flex items-center rounded-full bg-muted px-2 py-0.5 text-[11px] font-medium text-muted-foreground">
                  {String(mission.status ?? "planned")}
                </span>
                <span class="inline-flex items-center rounded-full border border-border bg-background px-2 py-0.5 text-[11px] font-medium text-muted-foreground">
                  graph: {String(mission.interest_graph_status ?? "pending")}
                </span>
              </div>
              <p class="text-sm text-muted-foreground">{String(mission.description ?? "No description")}</p>
              <div class="admin-table-chip-wrap">
                <span class="inline-flex items-center rounded-full border border-border bg-background px-2.5 py-1 text-[11px] font-medium text-muted-foreground">
                  Seeds {asStringList(mission.seed_topics).length || 0}
                </span>
                <span class="inline-flex items-center rounded-full border border-border bg-background px-2.5 py-1 text-[11px] font-medium text-muted-foreground">
                  Providers {asStringList(mission.target_provider_types).length || 0}
                </span>
                <span class="inline-flex items-center rounded-full border border-border bg-background px-2.5 py-1 text-[11px] font-medium text-muted-foreground">
                  Runs {String(mission.run_count ?? 0)}
                </span>
                <span class="inline-flex items-center rounded-full border border-border bg-background px-2.5 py-1 text-[11px] font-medium text-muted-foreground">
                  Spend {fmtMoney(mission.spent_cents ?? 0)}
                </span>
              </div>
              <p class="text-xs text-muted-foreground">
                Profile {String(mission.profile_display_name ?? mission.profile_key ?? "—")} · Version {String(mission.applied_profile_version ?? "—")} · Latest portfolio {String(mission.latest_portfolio_snapshot_id ?? "—")}
              </p>
            </div>
            <div class="flex flex-wrap gap-2">
              <a
                href={(missionSelectionHrefById[missionId] ?? "#")}
                data-admin-pane-open-link="discovery-missions"
                class:list={[
                  "inline-flex h-9 items-center justify-center rounded-md border px-3 text-sm font-medium transition-colors",
                  isSelected
                    ? "border-primary/40 bg-primary/10 text-primary"
                    : "border-input hover:bg-accent",
                ]}
              >
                Open pane
              </a>
              <a href={(missionPortfolioHrefById[missionId] ?? "#")} class="inline-flex h-9 items-center justify-center rounded-md border border-input px-3 text-sm font-medium transition-colors hover:bg-accent">
                Portfolio
              </a>
            </div>
          </div>
        </article>
      );
    })}
  </div>
  {(missions.hasPrev || missions.hasNext) && (
    <PaginationNav
      className="rounded-none border-x-0 border-b-0"
      page={missions.page}
      totalPages={missions.totalPages}
      hasPrev={missions.hasPrev}
      hasNext={missions.hasNext}
      prevHref={prevHref}
      nextHref={nextHref}
    />
  )}
</section>

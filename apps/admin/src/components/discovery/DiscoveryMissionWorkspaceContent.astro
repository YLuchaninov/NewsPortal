---
import { AdminConfirmAction } from "../AdminConfirmAction";
import {
  asStringList,
  fmtBudget,
  fmtMoney,
  type DiscoveryRecord,
} from "../../lib/server/discovery-view-model";

type Props = {
  attachableProfiles: DiscoveryRecord[];
  bffPath: string;
  currentPath: string;
  missionPortfolioHrefById: Record<string, string>;
  monthlyQuotaReached: boolean;
  selectedMissionWorkspace: DiscoveryRecord | null;
};

const {
  attachableProfiles,
  bffPath,
  currentPath,
  missionPortfolioHrefById,
  monthlyQuotaReached,
  selectedMissionWorkspace,
} = Astro.props as Props;
---

{selectedMissionWorkspace ? (() => {
  const mission = selectedMissionWorkspace;
  const missionId = String(mission.mission_id ?? "");
  const missionStatus = String(mission.status ?? "planned");
  const isMissionArchived = missionStatus === "archived";
  const missionActionLabel = isMissionArchived ? "Activate" : "Archive";
  const missionActionIntent = isMissionArchived ? "activate_mission" : "archive_mission";
  return (
    <div class="space-y-5">
      <div class="space-y-3">
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center rounded-full bg-muted px-2.5 py-1 text-[11px] font-medium text-muted-foreground">
            {missionStatus}
          </span>
          <span class="inline-flex items-center rounded-full border border-border bg-background px-2.5 py-1 text-[11px] font-medium text-muted-foreground">
            graph: {String(mission.interest_graph_status ?? "pending")}
          </span>
        </div>
        <div>
          <h2 class="text-2xl font-semibold tracking-tight">{String(mission.title ?? "Untitled mission")}</h2>
          <p class="mt-2 text-sm leading-6 text-muted-foreground">
            {String(mission.description ?? "No description recorded for this mission.")}
          </p>
        </div>
        <div class="grid gap-3 md:grid-cols-2">
          <div class="rounded-2xl border border-border bg-background px-4 py-3">
            <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-muted-foreground">Delivery</p>
            <p class="mt-2 text-sm font-semibold">Budget {fmtBudget(mission.budget_cents)}</p>
            <p class="mt-1 text-sm text-muted-foreground">
              Spend {fmtMoney(mission.spent_cents ?? 0)} · Runs {String(mission.run_count ?? 0)}
            </p>
          </div>
          <div class="rounded-2xl border border-border bg-background px-4 py-3">
            <p class="text-[11px] font-medium uppercase tracking-[0.16em] text-muted-foreground">Profile</p>
            <p class="mt-2 text-sm font-semibold">
              {String(mission.profile_display_name ?? mission.profile_key ?? "No reusable profile")}
            </p>
            <p class="mt-1 text-sm text-muted-foreground">
              Applied version {String(mission.applied_profile_version ?? "—")} · Priority {String(mission.priority ?? 0)}
            </p>
          </div>
        </div>
        <div class="rounded-2xl border border-border bg-background px-4 py-3 text-sm text-muted-foreground">
          Seeds {asStringList(mission.seed_topics).join(", ") || "—"}<br />
          Providers {asStringList(mission.target_provider_types).join(", ") || "rss, website, api, email_imap, youtube"}<br />
          Latest portfolio {String(mission.latest_portfolio_snapshot_id ?? "—")}
        </div>
      </div>

      <div class="flex flex-wrap gap-2">
        <form method="post" action={bffPath}>
          <input type="hidden" name="intent" value="compile_graph" />
          <input type="hidden" name="missionId" value={missionId} />
          <input type="hidden" name="redirectTo" value={currentPath} />
          <button
            type="submit"
            disabled={isMissionArchived}
            class:list={[
              "inline-flex h-9 items-center justify-center rounded-md border px-3 text-sm font-medium transition-colors",
              isMissionArchived
                ? "cursor-not-allowed border-border bg-muted text-muted-foreground"
                : "border-input hover:bg-accent",
            ]}
          >
            Compile graph
          </button>
        </form>
        <form method="post" action={bffPath}>
          <input type="hidden" name="intent" value="run_mission" />
          <input type="hidden" name="missionId" value={missionId} />
          <input type="hidden" name="redirectTo" value={currentPath} />
          <button
            type="submit"
            disabled={monthlyQuotaReached || isMissionArchived}
            class:list={[
              "inline-flex h-9 items-center justify-center rounded-md px-3 text-sm font-medium transition-colors",
              monthlyQuotaReached || isMissionArchived
                ? "cursor-not-allowed bg-muted text-muted-foreground"
                : "bg-primary text-primary-foreground hover:bg-primary/90",
            ]}
          >
            {isMissionArchived ? "Archived" : monthlyQuotaReached ? "Quota blocked" : "Run mission"}
          </button>
        </form>
        <a href={(missionPortfolioHrefById[missionId] ?? "#")} class="inline-flex h-9 items-center justify-center rounded-md border border-input px-3 text-sm font-medium transition-colors hover:bg-accent">
          Open portfolio
        </a>
        <AdminConfirmAction
          action={bffPath}
          title={isMissionArchived ? "Reactivate mission" : "Archive mission"}
          description={isMissionArchived
            ? "Return this mission to the planned backlog so it can be compiled or run again."
            : "Keep this mission readable in history but remove it from active planning and execution."}
          triggerLabel={missionActionLabel}
          confirmLabel={isMissionArchived ? "Reactivate mission" : "Archive mission"}
          fields={[
            { name: "intent", value: missionActionIntent },
            { name: "missionId", value: missionId },
            { name: "redirectTo", value: currentPath },
          ]}
          triggerClassName={isMissionArchived ? "border-emerald-200 text-emerald-700 hover:bg-emerald-50 dark:border-emerald-900/30 dark:text-emerald-300 dark:hover:bg-emerald-950/20" : "border-amber-200 text-amber-700 hover:bg-amber-50 dark:border-amber-900/30 dark:text-amber-300 dark:hover:bg-amber-950/20"}
          confirmClassName={isMissionArchived ? "bg-emerald-600 text-white hover:bg-emerald-600/90" : "bg-amber-600 text-white hover:bg-amber-600/90"}
          client:load
        />
        <AdminConfirmAction
          action={bffPath}
          title="Delete mission"
          description="Delete this mission permanently only if it has no discovery history. Archive it instead once runs, hypotheses, or feedback exist."
          triggerLabel="Delete"
          confirmLabel="Delete mission"
          fields={[
            { name: "intent", value: "delete_mission" },
            { name: "missionId", value: missionId },
            { name: "redirectTo", value: currentPath },
          ]}
          triggerClassName="border-rose-200 text-rose-700 hover:bg-rose-50 dark:border-rose-900/30 dark:text-rose-300 dark:hover:bg-rose-950/20"
          client:load
        />
      </div>

      <form method="post" action={bffPath} class="grid gap-3 rounded-2xl border border-border bg-background p-4 md:grid-cols-2">
        <input type="hidden" name="intent" value="update_mission" />
        <input type="hidden" name="missionId" value={missionId} />
        <input type="hidden" name="redirectTo" value={currentPath} />
        <label class="grid gap-1">
          <span class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted-foreground">Status</span>
          <select name="status" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring">
            {["planned", "active", "paused", "completed", "failed", "archived"].map((option) => (
              <option value={option} selected={missionStatus === option}>{option}</option>
            ))}
          </select>
        </label>
        <label class="grid gap-1">
          <span class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted-foreground">Priority</span>
          <input name="priority" type="number" value={String(mission.priority ?? 0)} class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring" />
        </label>
        <label class="grid gap-1">
          <span class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted-foreground">Budget</span>
          <input name="budgetCents" type="number" min="0" value={String(mission.budget_cents ?? 0)} class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring" />
        </label>
        <label class="grid gap-1">
          <span class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted-foreground">Profile</span>
          <select name="profileId" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring">
            <option value="">No reusable profile</option>
            {attachableProfiles.map((profile) => (
              <option
                value={String(profile.profile_id ?? "")}
                selected={String(mission.profile_id ?? "") === String(profile.profile_id ?? "")}
              >
                {String(profile.display_name ?? profile.profile_key ?? "Profile")}
              </option>
            ))}
          </select>
        </label>
        <div class="md:col-span-2">
          <button type="submit" class="inline-flex h-9 items-center justify-center rounded-md border border-input px-3 text-sm font-medium transition-colors hover:bg-accent">
            Save mission
          </button>
        </div>
      </form>
    </div>
  );
})() : (
  <div class="rounded-2xl border border-dashed border-border bg-background px-4 py-10 text-sm text-muted-foreground">
    Select a mission to review planning, budget, and run actions without leaving the list.
  </div>
)}

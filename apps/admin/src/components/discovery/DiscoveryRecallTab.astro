---
import { PaginationNav } from "@newsportal/ui";

import {
  asStringList,
  fmtDate,
  fmtPercent,
  metricSourceLabel,
  type DiscoveryPagedRecord,
  type DiscoveryRecord,
} from "../../lib/server/discovery-view-model";
import {
  resolveDiscoveryPolicyExplainability,
  resolveDiscoveryRecallCandidateState,
  resolveDiscoverySourceQuality,
  type DiscoveryOperatorSummary,
} from "../../lib/server/operator-surfaces";

type Props = {
  attachableProfiles: DiscoveryRecord[];
  bffPath: string;
  currentPath: string;
  operatorSummary: DiscoveryOperatorSummary;
  recallCandidateItems: DiscoveryRecord[];
  recallCandidateNextHref: string;
  recallCandidatePrevHref: string;
  recallCandidates: DiscoveryPagedRecord;
  recallMissionItems: DiscoveryRecord[];
  recallMissionNextHref: string;
  recallMissionPrevHref: string;
  recallMissions: DiscoveryPagedRecord;
};

const {
  attachableProfiles,
  bffPath,
  currentPath,
  operatorSummary,
  recallCandidateItems,
  recallCandidateNextHref,
  recallCandidatePrevHref,
  recallCandidates,
  recallMissionItems,
  recallMissionNextHref,
  recallMissionPrevHref,
  recallMissions,
} = Astro.props as Props;
---

<div class="grid gap-4 xl:grid-cols-[0.85fr_1.15fr]">
  <section class="rounded-2xl border border-border bg-card p-5 shadow-sm">
    <h2 class="text-base font-semibold">Independent recall missions</h2>
    <p class="mt-1 text-sm text-muted-foreground">
      These missions seed neutral acquisition without requiring `interest_graph`. This admin surface now owns the bounded operator loop for recall mission acquisition and candidate promotion while keeping the same maintenance-backed runtime truth.
    </p>
    <form method="post" action={bffPath} class="mt-4 grid gap-3 rounded-2xl border border-border bg-background p-4">
      <input type="hidden" name="intent" value="create_recall_mission" />
      <input type="hidden" name="redirectTo" value={currentPath} />
      <label class="grid gap-1.5">
        <span class="text-xs font-medium">Title</span>
        <input name="title" required class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring" />
      </label>
      <label class="grid gap-1.5">
        <span class="text-xs font-medium">Description</span>
        <textarea name="description" rows="3" class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
      </label>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Mission kind</span>
          <select name="missionKind" class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring">
            {["manual", "domain_seed", "query_seed"].map((option) => (
              <option value={option} selected={option === "domain_seed"}>{option}</option>
            ))}
          </select>
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Discovery profile</span>
          <select name="profileId" class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring">
            <option value="">No reusable profile</option>
            {attachableProfiles.map((profile) => (
              <option value={String(profile.profile_id ?? "")}>
                {String(profile.display_name ?? profile.profile_key ?? "Profile")} · v{String(profile.version ?? 1)}
              </option>
            ))}
          </select>
        </label>
      </div>
      <label class="grid gap-1.5">
        <span class="text-xs font-medium">Seed domains</span>
        <textarea name="seedDomains" rows="3" class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
      </label>
      <label class="grid gap-1.5">
        <span class="text-xs font-medium">Seed queries</span>
        <textarea name="seedQueries" rows="3" class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
      </label>
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Target provider types</span>
          <input name="targetProviderTypes" value="rss,website" class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring" />
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Max candidates</span>
          <input name="maxCandidates" type="number" min="1" value="12" class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring" />
        </label>
      </div>
      <label class="grid gap-1.5">
        <span class="text-xs font-medium">Optional scope JSON</span>
        <textarea name="scopeJson" rows="5" placeholder='{"regions":["EU"]}' class="w-full rounded-md border border-input bg-transparent px-3 py-2 font-mono text-xs shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
      </label>
      <button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90">
        Create recall mission
      </button>
    </form>
    <div class="mt-4 space-y-3">
      {recallMissionItems.length === 0 ? (
        <p class="rounded-2xl border border-dashed border-border bg-background px-4 py-6 text-sm text-muted-foreground">
          No recall missions yet. Create one to start neutral source acquisition.
        </p>
      ) : recallMissionItems.map((mission) => (
        <div class="rounded-2xl border border-border bg-background px-4 py-4">
          <div class="flex flex-wrap items-center gap-2">
            <h3 class="text-sm font-semibold">{String(mission.title ?? "Recall mission")}</h3>
            <span class="inline-flex items-center rounded-full bg-muted px-2 py-0.5 text-[11px] font-medium text-muted-foreground">
              {String(mission.status ?? "planned")}
            </span>
            <span class="inline-flex items-center rounded-full border border-border px-2 py-0.5 text-[11px] font-medium text-muted-foreground">
              {String(mission.mission_kind ?? "domain_seed")}
            </span>
          </div>
          <p class="mt-1 text-sm text-muted-foreground">{String(mission.description ?? "No description")}</p>
          <p class="mt-2 text-xs text-muted-foreground">
            Seed domains: {asStringList(mission.seed_domains).join(", ") || "—"}
          </p>
          <p class="mt-1 text-xs text-muted-foreground">
            Seed queries: {asStringList(mission.seed_queries).join(", ") || "—"}
          </p>
          <p class="mt-1 text-xs text-muted-foreground">
            Providers: {asStringList(mission.target_provider_types).join(", ") || "rss, website"} · Max candidates: {String(mission.max_candidates ?? "—")}
          </p>
          <p class="mt-1 text-xs text-muted-foreground">
            Profile: {String(mission.profile_display_name ?? mission.profile_key ?? "—")} · Applied version: {String(mission.applied_profile_version ?? "—")}
          </p>
          <p class="mt-1 text-xs text-muted-foreground">Updated {fmtDate(mission.updated_at)}</p>
          <div class="mt-3 grid gap-3 lg:grid-cols-[1fr_auto]">
            <form method="post" action={bffPath} class="grid gap-3 md:grid-cols-4">
              <input type="hidden" name="intent" value="update_recall_mission" />
              <input type="hidden" name="recallMissionId" value={String(mission.recall_mission_id ?? "")} />
              <input type="hidden" name="redirectTo" value={currentPath} />
              <label class="grid gap-1">
                <span class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted-foreground">Status</span>
                <select name="status" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring">
                  {["planned", "active", "paused", "completed", "failed"].map((option) => (
                    <option value={option} selected={String(mission.status ?? "planned") === option}>{option}</option>
                  ))}
                </select>
              </label>
              <label class="grid gap-1">
                <span class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted-foreground">Profile</span>
                <select name="profileId" class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring">
                  <option value="">No reusable profile</option>
                  {attachableProfiles.map((profile) => (
                    <option
                      value={String(profile.profile_id ?? "")}
                      selected={String(mission.profile_id ?? "") === String(profile.profile_id ?? "")}
                    >
                      {String(profile.display_name ?? profile.profile_key ?? "Profile")}
                    </option>
                  ))}
                </select>
              </label>
              <label class="grid gap-1">
                <span class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted-foreground">Max candidates</span>
                <input name="maxCandidates" type="number" min="1" value={String(mission.max_candidates ?? 12)} class="flex h-9 w-full rounded-md border border-input bg-transparent px-3 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring" />
              </label>
              <div class="grid gap-1">
                <span class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted-foreground">Update</span>
                <button type="submit" class="inline-flex h-9 items-center justify-center rounded-md border border-input px-3 text-sm font-medium transition-colors hover:bg-accent">
                  Save recall mission
                </button>
              </div>
            </form>
            <form method="post" action={bffPath} class="grid gap-1">
              <input type="hidden" name="intent" value="acquire_recall_mission" />
              <input type="hidden" name="recallMissionId" value={String(mission.recall_mission_id ?? "")} />
              <input type="hidden" name="redirectTo" value={currentPath} />
              <span class="text-[11px] font-medium uppercase tracking-[0.14em] text-muted-foreground">Run acquisition</span>
              <button type="submit" class="inline-flex h-9 items-center justify-center rounded-md border border-input px-3 text-sm font-medium transition-colors hover:bg-accent">
                Acquire now
              </button>
            </form>
          </div>
        </div>
      ))}
    </div>
    {(recallMissions.hasPrev || recallMissions.hasNext) && (
      <PaginationNav
        className="mt-4"
        page={recallMissions.page}
        totalPages={recallMissions.totalPages}
        hasPrev={recallMissions.hasPrev}
        hasNext={recallMissions.hasNext}
        prevHref={recallMissionPrevHref}
        nextHref={recallMissionNextHref}
      />
    )}
  </section>

  <section class="rounded-2xl border border-border bg-card shadow-sm overflow-hidden">
    <div class="border-b border-border px-5 py-4">
      <h2 class="text-base font-semibold">Recall candidates</h2>
      <p class="mt-1 text-sm text-muted-foreground">
        {recallCandidates.total} candidate{recallCandidates.total === 1 ? "" : "s"} total · {String(operatorSummary.promotedRecallCandidateCount)} promoted into normal channels
      </p>
    </div>
    <div class="divide-y divide-border">
      {recallCandidateItems.length === 0 ? (
        <p class="px-5 py-8 text-sm text-muted-foreground">No recall candidates yet. They appear here after recall acquisition runs.</p>
      ) : recallCandidateItems.map((candidate) => {
        const quality = resolveDiscoverySourceQuality(candidate);
        const recallState = resolveDiscoveryRecallCandidateState(candidate);
        const explainability = resolveDiscoveryPolicyExplainability(candidate, "recall");
        return (
          <div class="px-5 py-4">
            <div class="flex flex-col gap-3 xl:flex-row xl:items-start xl:justify-between">
              <div class="space-y-1">
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="text-sm font-semibold">{String(candidate.title ?? candidate.canonical_domain ?? candidate.url ?? "Recall candidate")}</h3>
                  <span class="inline-flex items-center rounded-full bg-muted px-2 py-0.5 text-[11px] font-medium text-muted-foreground">
                    {String(candidate.status ?? "pending")}
                  </span>
                  <span class="inline-flex items-center rounded-full border border-border bg-background px-2 py-0.5 text-[11px] font-medium text-muted-foreground">
                    {String(candidate.provider_type ?? "rss")}
                  </span>
                  <span class="inline-flex items-center rounded-full border border-emerald-300/50 bg-emerald-50/70 px-2 py-0.5 text-[11px] font-medium text-emerald-900 dark:border-emerald-900/50 dark:bg-emerald-950/20 dark:text-emerald-100">
                    {recallState.promotionState}
                  </span>
                </div>
                <a href={String(candidate.url ?? "#")} target="_blank" class="text-sm text-primary hover:underline break-all">
                  {String(candidate.url ?? "—")}
                </a>
                <p class="text-sm text-muted-foreground">{String(candidate.description ?? "No evaluation summary")}</p>
                <p class="text-xs text-muted-foreground">
                  Recall mission: {String(candidate.recall_mission_title ?? "—")} · Domain: {String(candidate.canonical_domain ?? "—")} · Quality signal: {String(candidate.quality_signal_source ?? "—")}
                </p>
                <p class="text-xs text-muted-foreground">
                  Snapshot: {quality.snapshotReason ?? "—"} · Scored {fmtDate(quality.scoredAt)}
                </p>
                <p class="text-xs text-muted-foreground">
                  Profile: {explainability.profileName ?? "—"} · Version: {String(explainability.profileVersion ?? "—")} · Reason bucket: {explainability.reasonBucket ?? "—"}
                </p>
                {recallState.registeredChannelId && (
                  <p class="text-xs text-muted-foreground">
                    Registered channel: {recallState.registeredChannelId}
                  </p>
                )}
              </div>
              <div class="rounded-2xl border border-border bg-background px-3 py-3 text-xs text-muted-foreground">
                <div>Generic recall {quality.recallScore == null ? "—" : fmtPercent(quality.recallScore)}</div>
                <div class="mt-1">Yield {fmtPercent(quality.yieldScore ?? 0)} · Lead {fmtPercent(quality.leadTimeScore ?? 0)} · Dupes {fmtPercent(quality.duplicationScore ?? 0)}</div>
                <div class="mt-1">Metric source {metricSourceLabel(quality.metricSource)}</div>
                <div class="mt-1">Channel link {recallState.channelId ?? "not linked yet"}</div>
                <div class="mt-2 border-t border-border pt-2">
                  <div>Threshold {explainability.threshold == null ? "—" : explainability.threshold.toFixed(2)} · Score {explainability.score == null ? "—" : explainability.score.toFixed(2)}</div>
                  <div class="mt-1">Fit {explainability.fitScore == null ? "—" : explainability.fitScore.toFixed(2)} · Quality prior {explainability.qualityPrior == null ? "—" : explainability.qualityPrior.toFixed(2)} · Final review {explainability.finalReviewScore == null ? "—" : explainability.finalReviewScore.toFixed(2)}</div>
                  <div class="mt-1">Policy verdict {explainability.policyVerdict ?? "—"} · Onboarding {explainability.onboardingVerdict ?? "—"} · Provider {explainability.provider ?? "—"}</div>
                  <div class="mt-1">Productivity risk {explainability.productivityRisk ?? "—"} · Diagnostic {explainability.usefulnessDiagnostic ?? "—"}</div>
                  <div class="mt-1">Source family {explainability.sourceFamily ?? "—"} · Source shape {explainability.sourceShape ?? "—"} · Stage loss {explainability.stageLossBucket ?? "—"}</div>
                  <div class="mt-1">Preferred domain {explainability.preferredDomainMatch ? "yes" : "no"} · Negative domain {explainability.negativeDomainMatch ? "yes" : "no"}</div>
                  <div class="mt-1">Positive keyword {explainability.positiveKeywordMatch ? "yes" : "no"} · Negative keyword {explainability.negativeKeywordMatch ? "yes" : "no"}</div>
                  <div class="mt-1">Benchmark-like {explainability.benchmarkLike ? "yes" : "no"}</div>
                  <div class="mt-1">Residuals {explainability.residuals.join(", ") || "—"}</div>
                </div>
                {(recallState.promotionState === "pending" || recallState.promotionState === "reviewed") && (
                  <form method="post" action={bffPath} class="mt-3 grid gap-1">
                    <input type="hidden" name="intent" value="promote_recall_candidate" />
                    <input type="hidden" name="recallCandidateId" value={String(candidate.recall_candidate_id ?? "")} />
                    <input type="hidden" name="redirectTo" value={currentPath} />
                    <input type="hidden" name="tags" value="admin_discovery_promote" />
                    <button type="submit" class="inline-flex h-9 items-center justify-center rounded-md border border-input px-3 text-sm font-medium transition-colors hover:bg-accent">
                      Promote
                    </button>
                  </form>
                )}
              </div>
            </div>
          </div>
        );
      })}
    </div>
    {(recallCandidates.hasPrev || recallCandidates.hasNext) && (
      <PaginationNav
        className="rounded-none border-x-0 border-b-0"
        page={recallCandidates.page}
        totalPages={recallCandidates.totalPages}
        hasPrev={recallCandidates.hasPrev}
        hasNext={recallCandidates.hasNext}
        prevHref={recallCandidatePrevHref}
        nextHref={recallCandidateNextHref}
      />
    )}
  </section>
</div>

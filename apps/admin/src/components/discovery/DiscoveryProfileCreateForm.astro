---
import { ADMIN_SECTION_CARD_CLASS } from "../../lib/admin-ui-classes";

type Props = {
  bffPath: string;
  currentPath: string;
};

const { bffPath, currentPath } = Astro.props as Props;
---

<section class={ADMIN_SECTION_CARD_CLASS}>
  <h2 class="text-base font-semibold">Create reusable profile</h2>
  <p class="mt-1 text-sm text-muted-foreground">
    Profiles own structured discovery tuning for graph and recall lanes. Missions still own seeds, budget, and run state.
  </p>
  <form method="post" action={bffPath} class="mt-4 grid gap-3">
    <input type="hidden" name="intent" value="create_profile" />
    <input type="hidden" name="redirectTo" value={currentPath} />
    <div class="grid gap-3 sm:grid-cols-2">
      <label class="grid gap-1.5">
        <span class="text-xs font-medium">Profile key</span>
        <input name="profileKey" required placeholder="editorial_news_default" class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring" />
      </label>
      <label class="grid gap-1.5">
        <span class="text-xs font-medium">Display name</span>
        <input name="displayName" required class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring" />
      </label>
    </div>
    <label class="grid gap-1.5">
      <span class="text-xs font-medium">Description</span>
      <textarea name="description" rows="3" class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
    </label>
    <label class="grid gap-1.5">
      <span class="text-xs font-medium">Status</span>
      <select name="status" class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring">
        {["draft", "active", "archived"].map((option) => (
          <option value={option} selected={option === "draft"}>{option}</option>
        ))}
      </select>
    </label>
    <div class="grid gap-3 lg:grid-cols-2">
      <div class="grid gap-3 rounded-2xl border border-border bg-background p-4">
        <div>
          <h3 class="text-sm font-semibold">Graph policy</h3>
          <p class="mt-1 text-xs text-muted-foreground">Used during graph mission review and explainability.</p>
        </div>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Provider types</span>
          <input name="graphProviderTypes" value="rss,website" class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring" />
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Supported website kinds</span>
          <textarea name="graphSupportedWebsiteKinds" rows="2" placeholder={"editorial\nprocurement_portal\nlisting"} class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
        </label>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="grid gap-1.5">
            <span class="text-xs font-medium">Min RSS review score</span>
            <input name="graphMinRssReviewScore" type="number" min="0" max="1" step="0.01" class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring" />
          </label>
          <label class="grid gap-1.5">
            <span class="text-xs font-medium">Min website review score</span>
            <input name="graphMinWebsiteReviewScore" type="number" min="0" max="1" step="0.01" class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring" />
          </label>
        </div>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Preferred domains</span>
          <textarea name="graphPreferredDomains" rows="3" class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Blocked domains</span>
          <textarea name="graphBlockedDomains" rows="3" class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Positive keywords</span>
          <textarea name="graphPositiveKeywords" rows="3" class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Negative keywords</span>
          <textarea name="graphNegativeKeywords" rows="3" class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Preferred tactics</span>
          <textarea name="graphPreferredTactics" rows="2" class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Expected source shapes</span>
          <textarea name="graphExpectedSourceShapes" rows="2" placeholder={"editorial_stream\ndocument_repository"} class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Allowed source families</span>
          <textarea name="graphAllowedSourceFamilies" rows="2" placeholder={"official_updates\neditorial_publication"} class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Disfavored source families</span>
          <textarea name="graphDisfavoredSourceFamilies" rows="2" placeholder={"aggregator_directory\nvendor_marketing"} class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
        </label>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="grid gap-1.5">
            <span class="text-xs font-medium">Max per source family</span>
            <input name="graphMaxPerSourceFamily" type="number" min="1" class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring" />
          </label>
          <label class="grid gap-1.5">
            <span class="text-xs font-medium">Max per domain</span>
            <input name="graphMaxPerDomain" type="number" min="1" class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring" />
          </label>
        </div>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Usefulness hints</span>
          <textarea name="graphUsefulnessHints" rows="2" placeholder="resource_only_expected" class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
        </label>
        <details class="group rounded-xl border border-dashed border-border px-3 py-2">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-medium [&::-webkit-details-marker]:hidden">
            <span>Expert-mode prompt override</span>
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-border bg-background text-muted-foreground transition group-open:rotate-180">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </span>
          </summary>
          <label class="mt-3 grid gap-1.5">
            <span class="text-xs font-medium">Graph prompt instructions</span>
            <textarea name="graphAdvancedPromptInstructions" rows="4" class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
          </label>
        </details>
      </div>
      <div class="grid gap-3 rounded-2xl border border-border bg-background p-4">
        <div>
          <h3 class="text-sm font-semibold">Recall policy</h3>
          <p class="mt-1 text-xs text-muted-foreground">Used during neutral recall shortlist/promotion review.</p>
        </div>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Provider types</span>
          <input name="recallProviderTypes" value="rss,website" class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring" />
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Supported website kinds</span>
          <textarea name="recallSupportedWebsiteKinds" rows="2" placeholder={"editorial\nprocurement_portal\nlisting"} class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Min promotion score</span>
          <input name="recallMinPromotionScore" type="number" min="0" max="1" step="0.01" class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring" />
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Preferred domains</span>
          <textarea name="recallPreferredDomains" rows="3" class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Blocked domains</span>
          <textarea name="recallBlockedDomains" rows="3" class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Positive keywords</span>
          <textarea name="recallPositiveKeywords" rows="3" class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Negative keywords</span>
          <textarea name="recallNegativeKeywords" rows="3" class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Preferred tactics</span>
          <textarea name="recallPreferredTactics" rows="2" class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Expected source shapes</span>
          <textarea name="recallExpectedSourceShapes" rows="2" placeholder={"listing_resource\ndocument_repository"} class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Allowed source families</span>
          <textarea name="recallAllowedSourceFamilies" rows="2" placeholder={"procurement_listing\ndocument_repository"} class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Disfavored source families</span>
          <textarea name="recallDisfavoredSourceFamilies" rows="2" placeholder={"aggregator_directory\nvendor_marketing"} class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
        </label>
        <div class="grid gap-3 sm:grid-cols-2">
          <label class="grid gap-1.5">
            <span class="text-xs font-medium">Max per source family</span>
            <input name="recallMaxPerSourceFamily" type="number" min="1" class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring" />
          </label>
          <label class="grid gap-1.5">
            <span class="text-xs font-medium">Max per domain</span>
            <input name="recallMaxPerDomain" type="number" min="1" class="flex h-10 w-full rounded-md border border-input bg-transparent px-3 py-1 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring" />
          </label>
        </div>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Usefulness hints</span>
          <textarea name="recallUsefulnessHints" rows="2" placeholder="resource_only_expected" class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
        </label>
        <details class="group rounded-xl border border-dashed border-border px-3 py-2">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-medium [&::-webkit-details-marker]:hidden">
            <span>Expert-mode prompt override</span>
            <span class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-border bg-background text-muted-foreground transition group-open:rotate-180">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </span>
          </summary>
          <label class="mt-3 grid gap-1.5">
            <span class="text-xs font-medium">Recall prompt instructions</span>
            <textarea name="recallAdvancedPromptInstructions" rows="4" class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
          </label>
        </details>
      </div>
    </div>
    <div class="grid gap-3 rounded-2xl border border-border bg-background p-4">
      <div>
        <h3 class="text-sm font-semibold">Yield benchmark</h3>
        <p class="mt-1 text-xs text-muted-foreground">Used only for operator tuning and explainability, not as downstream truth input.</p>
      </div>
      <div class="grid gap-3 md:grid-cols-3">
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Benchmark domains</span>
          <textarea name="benchmarkDomains" rows="4" class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Title keywords</span>
          <textarea name="benchmarkTitleKeywords" rows="4" class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
        </label>
        <label class="grid gap-1.5">
          <span class="text-xs font-medium">Tactic keywords</span>
          <textarea name="benchmarkTacticKeywords" rows="4" class="w-full rounded-md border border-input bg-transparent px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"></textarea>
        </label>
      </div>
    </div>
    <button type="submit" class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90">
      Create profile
    </button>
  </form>
</section>

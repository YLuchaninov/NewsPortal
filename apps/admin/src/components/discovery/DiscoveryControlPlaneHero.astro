---
import {
  fmtBudget,
  fmtMoney,
  fmtUsd,
  type DiscoveryRecord,
} from "../../lib/server/discovery-view-model";
import type { DiscoveryOperatorSummary } from "../../lib/server/operator-surfaces";
import {
  ADMIN_BACKGROUND_TILE_CLASS,
  ADMIN_COMPACT_METRIC_TILE_CLASS,
  ADMIN_HERO_CARD_CLASS,
} from "../../lib/admin-ui-classes";

type DiscoveryTabLink = {
  key: string;
  label: string;
  href: string;
};

type Props = {
  activeLlmModel: string;
  activeSearchProvider: string;
  defaultCron: unknown;
  monthToDateCostUsd: unknown;
  monthlyBudgetCents: unknown;
  monthlyQuotaReached: boolean;
  operatorSummary: DiscoveryOperatorSummary;
  remainingMonthlyBudgetCents: unknown;
  summary: DiscoveryRecord;
  tab: string;
  tabs: DiscoveryTabLink[];
};

const {
  activeLlmModel,
  activeSearchProvider,
  defaultCron,
  monthToDateCostUsd,
  monthlyBudgetCents,
  monthlyQuotaReached,
  operatorSummary,
  remainingMonthlyBudgetCents,
  summary,
  tab,
  tabs,
} = Astro.props as Props;
---

<div class={ADMIN_HERO_CARD_CLASS}>
  <div class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between">
    <div class="max-w-3xl">
      <p class="text-xs font-medium uppercase tracking-[0.2em] text-primary/80">Adaptive Discovery Agent</p>
      <h1 class="mt-2 text-2xl font-semibold tracking-tight">Dual-path discovery control plane</h1>
      <p class="mt-2 text-sm leading-6 text-muted-foreground">
        Discovery now follows a clearer operator split. Overview stays here, while reusable profiles, graph missions, recall acquisition, the candidate queue, and source-quality review each get their own focused route instead of competing inside one mega-screen.
      </p>
    </div>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      <div class={`flex min-h-[8.25rem] flex-col ${ADMIN_COMPACT_METRIC_TILE_CLASS}`}>
        <p class="text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Enabled</p>
        <p class={`mt-auto pt-4 text-4xl font-semibold leading-none ${summary.enabled ? "text-emerald-500" : "text-slate-500"}`}>
          {summary.enabled ? "Yes" : "No"}
        </p>
      </div>
      <div class={`flex min-h-[8.25rem] flex-col ${ADMIN_COMPACT_METRIC_TILE_CLASS}`}>
        <p class="text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Graph missions</p>
        <p class="mt-auto pt-4 text-4xl font-semibold leading-none">{String(operatorSummary.graphMissionCount)}</p>
      </div>
      <div class={`flex min-h-[8.25rem] flex-col ${ADMIN_COMPACT_METRIC_TILE_CLASS}`}>
        <p class="text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Recall missions</p>
        <p class="mt-auto pt-4 text-4xl font-semibold leading-none">{String(operatorSummary.recallMissionCount)}</p>
      </div>
      <div class={`flex min-h-[8.25rem] flex-col ${ADMIN_COMPACT_METRIC_TILE_CLASS}`}>
        <p class="text-[11px] uppercase tracking-[0.16em] text-muted-foreground">This month</p>
        <p class="mt-auto overflow-hidden whitespace-nowrap pt-4 text-[clamp(2rem,2.6vw,2.25rem)] font-semibold leading-none tracking-tight">
          {fmtUsd(monthToDateCostUsd)}
        </p>
      </div>
    </div>
  </div>

  <div class="mt-5 flex flex-wrap gap-2">
    {tabs.map((item) => (
      <a
        href={item.href}
        class:list={[
          "inline-flex items-center rounded-full px-3 py-1.5 text-sm font-medium transition-colors",
          tab === item.key || (tab === "dashboard" && item.key === "dashboard")
            ? "bg-primary text-primary-foreground"
            : "bg-muted text-muted-foreground hover:bg-accent hover:text-foreground",
        ]}
      >
        {item.label}
      </a>
    ))}
  </div>

  {monthlyQuotaReached && (
    <div class="mt-4 rounded-2xl border border-amber-500/40 bg-amber-500/10 px-4 py-3 text-sm text-amber-950">
      Monthly discovery quota is exhausted for the current UTC month. Planning and mission runs will remain blocked until the quota resets or `DISCOVERY_MONTHLY_BUDGET_CENTS` is increased.
    </div>
  )}

  <div class="mt-4 grid gap-3 sm:grid-cols-4">
    <div class={ADMIN_BACKGROUND_TILE_CLASS}>
      <p class="text-sm font-medium">Search provider</p>
      <p class="mt-1 text-sm text-muted-foreground">{activeSearchProvider}</p>
    </div>
    <div class={ADMIN_BACKGROUND_TILE_CLASS}>
      <p class="text-sm font-medium">Discovery LLM</p>
      <p class="mt-1 text-sm text-muted-foreground break-all">{activeLlmModel}</p>
    </div>
    <div class={ADMIN_BACKGROUND_TILE_CLASS}>
      <p class="text-sm font-medium">Monthly quota</p>
      <p class="mt-1 text-sm text-muted-foreground">
        {fmtBudget(monthlyBudgetCents)}
        {Number(monthlyBudgetCents) > 0 ? ` · ${fmtMoney(remainingMonthlyBudgetCents)} left` : ""}
      </p>
    </div>
    <div class={ADMIN_BACKGROUND_TILE_CLASS}>
      <p class="text-sm font-medium">Default cron</p>
      <p class="mt-1 text-sm text-muted-foreground font-mono">{String(summary.defaultCron ?? defaultCron)}</p>
    </div>
  </div>

  <div class="mt-4 rounded-2xl border border-sky-200 bg-sky-50/60 px-4 py-3 text-sm text-sky-950 dark:border-sky-900/40 dark:bg-sky-950/20 dark:text-sky-100">
    <strong>Operator note:</strong> keep these meanings separate. <em>Mission fit</em> stays graph-scoped and portfolio-specific, <em>generic source quality</em> comes from additive recall/source snapshots, <em>neutral recall backlog</em> tracks acquisition without `interest_graph`, and <em>promotion state</em> shows which recall candidates have already become normal `source_channels`. None of these signals should be interpreted as downstream selected-content yield.
  </div>
</div>

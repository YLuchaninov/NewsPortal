---
import AdminWorkspacePane from "../AdminWorkspacePane.astro";
import DiscoveryMissionCreateForm from "./DiscoveryMissionCreateForm.astro";
import DiscoveryMissionList from "./DiscoveryMissionList.astro";
import DiscoveryMissionWorkspaceContent from "./DiscoveryMissionWorkspaceContent.astro";
import {
  type DiscoveryPagedRecord,
  type DiscoveryRecord,
} from "../../lib/server/discovery-view-model";

type Props = {
  attachableProfiles: DiscoveryRecord[];
  bffPath: string;
  currentPath: string;
  missionItems: DiscoveryRecord[];
  missionPortfolioHrefById: Record<string, string>;
  missionSelectionHrefById: Record<string, string>;
  missions: DiscoveryPagedRecord;
  monthlyQuotaReached: boolean;
  nextHref: string;
  prevHref: string;
  selectedMissionWorkspace: DiscoveryRecord | null;
  selectedMissionWorkspaceId: string;
  summary: DiscoveryRecord;
};

const {
  attachableProfiles,
  bffPath,
  currentPath,
  missionItems,
  missionPortfolioHrefById,
  missionSelectionHrefById,
  missions,
  monthlyQuotaReached,
  nextHref,
  prevHref,
  selectedMissionWorkspace,
  selectedMissionWorkspaceId,
  summary,
} = Astro.props as Props;
---

<AdminWorkspacePane
  paneId="discovery-missions"
  paneLabel="Mission workspace"
  collapsedLabel="Mission"
  defaultWidth={540}
  minWidth={420}
  maxWidth={760}
  minMainWidth={760}
>
  <Fragment slot="main">
    <div class="space-y-4">
      <DiscoveryMissionCreateForm
        attachableProfiles={attachableProfiles}
        bffPath={bffPath}
        currentPath={currentPath}
        missionItems={missionItems}
        summary={summary}
      />
      <DiscoveryMissionList
        missionItems={missionItems}
        missionPortfolioHrefById={missionPortfolioHrefById}
        missionSelectionHrefById={missionSelectionHrefById}
        missions={missions}
        nextHref={nextHref}
        prevHref={prevHref}
        selectedMissionWorkspaceId={selectedMissionWorkspaceId}
      />
    </div>
  </Fragment>

  <Fragment slot="pane">
    <DiscoveryMissionWorkspaceContent
      attachableProfiles={attachableProfiles}
      bffPath={bffPath}
      currentPath={currentPath}
      missionPortfolioHrefById={missionPortfolioHrefById}
      monthlyQuotaReached={monthlyQuotaReached}
      selectedMissionWorkspace={selectedMissionWorkspace}
    />
  </Fragment>
</AdminWorkspacePane>

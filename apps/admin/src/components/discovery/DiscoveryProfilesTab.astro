---
import DiscoveryProfileCreateForm from "./DiscoveryProfileCreateForm.astro";
import DiscoveryProfileList from "./DiscoveryProfileList.astro";
import {
  type DiscoveryPagedRecord,
  type DiscoveryRecord,
} from "../../lib/server/discovery-view-model";
import {
  type DiscoveryOperatorSummary,
} from "../../lib/server/operator-surfaces";

type Props = {
  bffPath: string;
  candidateItems: DiscoveryRecord[];
  currentPath: string;
  missionItems: DiscoveryRecord[];
  nextHref: string;
  operatorSummary: DiscoveryOperatorSummary;
  prevHref: string;
  profileItems: DiscoveryRecord[];
  profiles: DiscoveryPagedRecord;
  recallMissionItems: DiscoveryRecord[];
};

const {
  bffPath,
  candidateItems,
  currentPath,
  missionItems,
  nextHref,
  operatorSummary,
  prevHref,
  profileItems,
  profiles,
  recallMissionItems,
} = Astro.props as Props;
---

<div class="grid gap-4 xl:grid-cols-[0.8fr_1.2fr]">
  <DiscoveryProfileCreateForm bffPath={bffPath} currentPath={currentPath} />
  <DiscoveryProfileList
    bffPath={bffPath}
    candidateItems={candidateItems}
    currentPath={currentPath}
    missionItems={missionItems}
    nextHref={nextHref}
    operatorSummary={operatorSummary}
    prevHref={prevHref}
    profileItems={profileItems}
    profiles={profiles}
    recallMissionItems={recallMissionItems}
  />
</div>

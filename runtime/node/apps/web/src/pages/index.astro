---
import { DEFAULT_BRAND_CONFIG, readRuntimeConfig } from "@signalops/config";
import {
  DEFAULT_PAGE,
  type ContentItemPreview,
  type WebContentListSort,
} from "@signalops/contracts";
import { PaginationNav } from "@signalops/ui";
import { buildLiveRevision } from "../lib/live-updates";
import Shell from "../layouts/Shell.astro";
import { ContentItemCard } from "../components/ContentItemCard";
import { LiveSurfaceSummary } from "../components/LiveSurfaceSummary";
import { getPool, queryOne } from "../lib/server/db";
import { resolveWebSession } from "../lib/server/auth";
import { readFlash } from "../lib/server/browser-flow";
import { loadPublicRedactedSignals } from "../lib/server/public-redacted-content";
import { createWebServerSdk } from "../lib/server/sdk";
import { getUserContentStateMap } from "../lib/server/user-content-state";
import { WEB_CARD_GRID_PAGE_SIZE, createPageHrefResolver, parsePositivePage } from "../lib/view-helpers";

export const prerender = false;
const WEB_CONTENT_SORT_OPTIONS: Array<{ value: WebContentListSort; label: string }> = [
  { value: "latest", label: "Newest first" },
  { value: "oldest", label: "Oldest first" },
  { value: "title_asc", label: "Title A-Z" },
  { value: "title_desc", label: "Title Z-A" },
];

function isWebContentListSort(value: string | null): value is WebContentListSort {
  return WEB_CONTENT_SORT_OPTIONS.some((option) => option.value === value);
}

const session = await resolveWebSession(Astro.request);
const flash = readFlash(Astro.url);
const runtimeConfig = readRuntimeConfig(process.env, { defaultAppBaseUrl: "http://127.0.0.1:4321/" });
const sdk = createWebServerSdk(Astro.request);

const pageBaseUrl = new URL(Astro.url);
if (!pageBaseUrl.pathname.endsWith("/")) pageBaseUrl.pathname += "/";
function resolvePageAppPath(t: string) {
  return new URL(t.replace(/^\/+/, ""), pageBaseUrl).pathname;
}

const bffPaths = {
  authBootstrap: resolvePageAppPath("bff/auth/bootstrap"),
  authGoogle: resolvePageAppPath("bff/auth/google"),
  authLogout: resolvePageAppPath("bff/auth/logout"),
  liveUpdates: resolvePageAppPath("bff/live-updates"),
  preferences: resolvePageAppPath("bff/preferences"),
  reactions: resolvePageAppPath("bff/reactions"),
  contentState: resolvePageAppPath("bff/content-state"),
};

const page = parsePositivePage(Astro.url, "page", DEFAULT_PAGE);
const requestedQuery = Astro.url.searchParams.get("q") ?? "";
const searchQuery = requestedQuery.trim();
const requestedSort = Astro.url.searchParams.get("sort");
const selectedSort: WebContentListSort = isWebContentListSort(requestedSort)
  ? requestedSort
  : "latest";
const hasActiveFilters = searchQuery.length > 0 || selectedSort !== "latest";
const signedInCollection = session
  ? await sdk.listSystemSelectedContentItems<ContentItemPreview>({
      page,
      pageSize: WEB_CARD_GRID_PAGE_SIZE,
      sort: selectedSort,
      q: searchQuery || undefined,
    })
  : null;
const publicCollection = session ? null : await loadPublicRedactedSignals(WEB_CARD_GRID_PAGE_SIZE);
const contentItems = signedInCollection?.items ?? [];
const redactedItems = publicCollection?.items ?? [];
const collectionTotal = signedInCollection?.total ?? publicCollection?.total ?? 0;
const collectionPage = signedInCollection?.page ?? DEFAULT_PAGE;
const collectionTotalPages = signedInCollection?.totalPages ?? 1;
const feedRevision = buildLiveRevision([
  collectionTotal,
  contentItems[0]?.content_item_id,
  contentItems[0]?.published_at ?? contentItems[0]?.ingested_at,
]);
const profile = session
  ? await queryOne<Record<string, unknown>>(
      `select theme_preference from user_profiles where user_id = $1`,
      [session.userId]
    )
  : null;
const userStateMap =
  session != null
    ? await getUserContentStateMap(getPool(), session.userId, contentItems)
    : new Map();
const themePreference = String(profile?.theme_preference ?? "system");
const themeClass = themePreference === "dark" ? "dark" : "";
const currentPath = `${Astro.url.pathname}${Astro.url.search}`;
const clearFiltersHref = Astro.url.pathname;

const resolvePageHref = createPageHrefResolver(Astro.url, DEFAULT_PAGE);
---

<Shell
  title={`${DEFAULT_BRAND_CONFIG.productName} — System Collection`}
  session={session}
  themeClass={themeClass}
  currentTheme={themePreference}
  flash={flash}
  activeNav="feed"
  bffLiveUpdatesPath={bffPaths.liveUpdates}
  bffPreferencesPath={bffPaths.preferences}
  bffLogoutPath={bffPaths.authLogout}
  bffBootstrapPath={bffPaths.authBootstrap}
  bffGoogleAuthPath={bffPaths.authGoogle}
  googleClientId={runtimeConfig.webGoogleClientId}
>
  <!-- Page header -->
  <div class="mb-8">
    <h1 class="text-3xl font-bold tracking-tight">{DEFAULT_BRAND_CONFIG.productName}</h1>
    <p class="text-muted-foreground mt-1">{DEFAULT_BRAND_CONFIG.tagline}</p>
    {session ? (
      <LiveSurfaceSummary
        surface="feed"
        initialCount={collectionTotal}
        initialRevision={feedRevision}
        page={collectionPage}
        totalPages={collectionTotalPages}
        singularLabel="content item"
        pluralLabel="content items"
        suffix=" in the system-selected collection"
        refreshHref={currentPath}
        client:load
      />
    ) : (
      <p class="text-xs text-muted-foreground mt-3">
        {collectionTotal} signal{collectionTotal !== 1 ? "s" : ""} in the system
      </p>
    )}
  </div>

  {session && (
    <form method="get" action={Astro.url.pathname} class="mb-8 rounded-xl border border-border bg-card p-4 shadow-sm">
      <div class="flex flex-col gap-3 lg:flex-row lg:items-end">
        <div class="flex-1">
          <label for="feed-search" class="mb-1 block text-sm font-medium text-foreground">Search</label>
          <input
            id="feed-search"
            type="search"
            name="q"
            value={searchQuery}
            placeholder="Search title or text"
            class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
          />
        </div>
        <div class="w-full lg:w-56">
          <label for="feed-sort" class="mb-1 block text-sm font-medium text-foreground">Sort</label>
          <select
            id="feed-sort"
            name="sort"
            class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm shadow-sm outline-none focus-visible:ring-1 focus-visible:ring-ring"
          >
            {WEB_CONTENT_SORT_OPTIONS.map((option) => (
              <option value={option.value} selected={option.value === selectedSort}>{option.label}</option>
            ))}
          </select>
        </div>
        <div class="flex gap-2 lg:pb-0">
          <button
            type="submit"
            class="inline-flex h-10 items-center justify-center rounded-md bg-primary px-4 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
          >
            Apply
          </button>
          <a
            href={clearFiltersHref}
            class="inline-flex h-10 items-center justify-center rounded-md border border-input px-4 text-sm font-medium text-muted-foreground transition-colors hover:bg-accent hover:text-foreground"
          >
            Clear filters
          </a>
        </div>
      </div>
    </form>
  )}

  {(session ? contentItems.length : redactedItems.length) === 0 ? (
    <div class="flex flex-col items-center justify-center py-24 text-center">
      <div class="h-16 w-16 rounded-full bg-muted flex items-center justify-center mb-4">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="text-muted-foreground">
          <path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8"/><path d="M15 18h-5"/><path d="M10 6h8v4h-8V6Z"/>
        </svg>
      </div>
      <p class="font-semibold text-lg">{hasActiveFilters ? "No results found" : "No content yet"}</p>
      <p class="text-muted-foreground text-sm mt-1">
        {hasActiveFilters
          ? "Try a different search or sort option, or clear the current filters to see the full collection."
          : "Content will appear here once active system interests allow it into the global collection."}
      </p>
    </div>
  ) : session ? (
    <>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {contentItems.map((contentItem) => (
          <ContentItemCard
            contentItem={contentItem}
            isLoggedIn={!!session}
            reactionsPath={bffPaths.reactions}
            contentStatePath={bffPaths.contentState}
            initialUserState={userStateMap.get(String(contentItem.content_item_id))}
            client:visible
          />
        ))}
      </div>
      {signedInCollection && (signedInCollection.hasPrev || signedInCollection.hasNext) && (
        <PaginationNav
          className="mt-8"
          page={signedInCollection.page}
          totalPages={signedInCollection.totalPages}
          hasPrev={signedInCollection.hasPrev}
          hasNext={signedInCollection.hasNext}
          prevHref={resolvePageHref(signedInCollection.page - 1)}
          nextHref={resolvePageHref(signedInCollection.page + 1)}
        />
      )}
    </>
  ) : (
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {redactedItems.map((item) => (
        <article class="flex min-h-56 flex-col rounded-xl border border-border bg-card p-5 shadow-sm">
          <div class="mb-5 flex items-center justify-between">
            <span class="inline-flex items-center rounded-full bg-secondary px-2.5 py-1 text-xs font-medium text-secondary-foreground">
              Signal {item.index}
            </span>
            {item.lang && (
              <span class="inline-flex items-center rounded-full bg-muted px-2.5 py-1 text-xs font-medium text-muted-foreground">
                {item.lang.toUpperCase()}
              </span>
            )}
          </div>
          <div class="flex flex-1 flex-col justify-between gap-6">
            <div class="space-y-3">
              <p class="text-sm font-medium text-muted-foreground">Redacted signal card</p>
              <h2 class="text-xl font-semibold leading-snug text-foreground">
                Verified signal details are available after Google sign-in
              </h2>
            </div>
            <div class="flex flex-wrap gap-2 text-xs text-muted-foreground">
              <span class="rounded-full bg-background px-2.5 py-1">{item.contentKind}</span>
              {item.publishedBucket && (
                <span class="rounded-full bg-background px-2.5 py-1">{item.publishedBucket}</span>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  )}
</Shell>

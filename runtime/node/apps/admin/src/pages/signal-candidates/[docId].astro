---
import type { SignalCandidateDetail, SignalCandidateMediaAsset } from "@signalops/contracts";
import { readRuntimeConfig } from "@signalops/config";
import { sanitizeHtmlFragment } from "@signalops/content-safety";
import { createSignalOpsSdk } from "@signalops/sdk";

import AdminShell from "../../layouts/AdminShell.astro";
import { resolveAdminSession } from "../../lib/server/auth";
import {
  resolveSignalCandidateOperatorGuidance,
  resolveSignalCandidateOperatorState,
  resolveSignalCandidateSelectionDiagnostics,
} from "../../lib/server/operator-surfaces";
import {
  buildAdminSignInPath,
  readFlash,
  resolveAdminAppPath,
  resolveAdminCurrentPath,
} from "../../lib/server/browser-flow";
import {
  ADMIN_BACKGROUND_TILE_CLASS,
  ADMIN_HERO_CARD_CLASS,
  ADMIN_SECTION_CARD_CLASS,
} from "../../lib/admin-ui-classes";
import { formatTimestamp } from "../../lib/view-helpers";

export const prerender = false;

const runtimeConfig = readRuntimeConfig(process.env, { defaultAppBaseUrl: "http://127.0.0.1:4322/" });
const session = await resolveAdminSession(Astro.request);
const appPath = (target = "/") => resolveAdminAppPath(Astro.request, target);
if (!session) {
  return Astro.redirect(
    buildAdminSignInPath(Astro.request, resolveAdminCurrentPath(Astro.request))
  );
}

const flash = readFlash(Astro.url);
const sdk = createSignalOpsSdk({ baseUrl: runtimeConfig.apiBaseUrl, fetchImpl: fetch });
const docId = String(Astro.params.docId ?? "").trim();

if (!docId) {
  return new Response("SignalCandidate not found.", { status: 404 });
}

let signal_candidate: SignalCandidateDetail;
try {
  signal_candidate = await sdk.getSignalCandidate<SignalCandidateDetail>(docId);
} catch {
  return new Response("SignalCandidate not found.", { status: 404 });
}

function resolveSafeHref(rawValue: unknown): string | null {
  if (typeof rawValue !== "string" || !rawValue.trim()) {
    return null;
  }

  try {
    const normalized = new URL(rawValue);
    if (!["http:", "https:"].includes(normalized.protocol)) {
      return null;
    }
    return normalized.toString();
  } catch {
    return null;
  }
}

function formatReadTime(rawValue: unknown): string {
  const seconds = Number(rawValue ?? NaN);
  if (!Number.isFinite(seconds) || seconds <= 0) {
    return "—";
  }

  return `${Math.max(1, Math.round(seconds / 60))} min`;
}

function toMediaAssets(rawValue: unknown): SignalCandidateMediaAsset[] {
  return Array.isArray(rawValue) ? (rawValue as SignalCandidateMediaAsset[]) : [];
}

function shortId(rawValue: unknown): string {
  const normalized = String(rawValue ?? "").trim();
  return normalized ? normalized.slice(0, 8) : "—";
}

const sourceHref = resolveSafeHref(signal_candidate.url);
const canonicalHref = resolveSafeHref(signal_candidate.canonical_document_url);
const signalCandidateHtml = sanitizeHtmlFragment(signal_candidate.full_content_html ?? null, {
  baseUrl: canonicalHref ?? sourceHref,
});
const mediaAssets = toMediaAssets(signal_candidate.media_assets);
const retryPath = appPath("/bff/admin/signal-candidates/enrichment-retry");
const currentPath = `${Astro.url.pathname}${Astro.url.search}`;
const operatorState = resolveSignalCandidateOperatorState(signal_candidate);
const operatorGuidance = resolveSignalCandidateOperatorGuidance(signal_candidate);
const selectionDiagnostics = resolveSignalCandidateSelectionDiagnostics(
  { selection_diagnostics: signal_candidate.selection_diagnostics },
  signal_candidate
);
const analysisSummary =
  signal_candidate.analysis_summary && typeof signal_candidate.analysis_summary === "object"
    ? (signal_candidate.analysis_summary as Record<string, unknown>)
    : {};
const analysisEntities = Array.isArray(analysisSummary.entities)
  ? (analysisSummary.entities as Record<string, unknown>[])
  : [];
const analysisLabels = Array.isArray(analysisSummary.labels)
  ? (analysisSummary.labels as Record<string, unknown>[])
  : [];
const analysisFilter =
  analysisSummary.contentFilter && typeof analysisSummary.contentFilter === "object"
    ? (analysisSummary.contentFilter as Record<string, unknown>)
    : null;

const finalSelectionColor: Record<string, string> = {
  selected: "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-300",
  gray_zone: "bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300",
  rejected: "bg-slate-100 text-slate-800 dark:bg-slate-900/30 dark:text-slate-300",
};

const selectionModeColor: Record<string, string> = {
  selected: "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-300",
  rejected: "bg-slate-100 text-slate-800 dark:bg-slate-900/30 dark:text-slate-300",
  hold: "bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300",
  llm_review_pending:
    "bg-orange-100 text-orange-800 dark:bg-orange-900/30 dark:text-orange-300",
  gray_zone: "bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300",
  compatibility_only: "bg-sky-100 text-sky-800 dark:bg-sky-900/30 dark:text-sky-300",
  pending: "bg-muted text-muted-foreground",
};

const systemFeedColor: Record<string, string> = {
  eligible: "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-300",
  pass_through: "bg-sky-100 text-sky-800 dark:bg-sky-900/30 dark:text-sky-300",
  pending_llm: "bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300",
  filtered_out: "bg-slate-100 text-slate-800 dark:bg-slate-900/30 dark:text-slate-300",
};

const verificationColor: Record<string, string> = {
  strong: "bg-emerald-100 text-emerald-800 dark:bg-emerald-900/30 dark:text-emerald-300",
  medium: "bg-sky-100 text-sky-800 dark:bg-sky-900/30 dark:text-sky-300",
  weak: "bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300",
  conflicting: "bg-red-100 text-red-800 dark:bg-red-900/30 dark:text-red-300",
};
---

<AdminShell title="SignalCandidate Detail — Admin" session={session} flash={flash} activeNav="signal_candidates">
  <Fragment slot="header-title">
    <nav class="flex items-center gap-1 text-sm text-muted-foreground">
      <a href={appPath("/")} class="hover:text-foreground">Dashboard</a>
      <span>/</span>
      <a href={appPath("/signal-candidates")} class="hover:text-foreground">Signal Candidates</a>
      <span>/</span>
      <span class="text-foreground font-medium">Detail</span>
    </nav>
  </Fragment>

  <Fragment slot="header-actions">
    <form method="post" action={retryPath}>
      <input type="hidden" name="docId" value={docId} />
      <input type="hidden" name="redirectTo" value={currentPath} />
      <button
        type="submit"
        class="inline-flex h-9 items-center justify-center rounded-md bg-primary px-3 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90"
      >
        Retry enrichment
      </button>
    </form>
    {sourceHref && (
      <a
        href={sourceHref}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex h-9 items-center justify-center rounded-md border border-input px-3 text-sm font-medium transition-colors hover:bg-accent"
      >
        Open source
      </a>
    )}
  </Fragment>

  <div class="space-y-6">
    <div class={ADMIN_HERO_CARD_CLASS}>
      <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
        <span class={`inline-flex items-center rounded-full px-2.5 py-1 font-medium ${selectionModeColor[String(operatorState.selectionMode)] ?? "bg-muted text-muted-foreground"}`}>
          mode:{String(operatorState.selectionMode)}
        </span>
        {operatorState.selectionDecision && (
          <span class={`inline-flex items-center rounded-full px-2.5 py-1 font-medium ${finalSelectionColor[String(operatorState.selectionDecision)] ?? systemFeedColor[String(operatorState.selectionDecision)] ?? "bg-muted text-muted-foreground"}`}>
            decision:{String(operatorState.selectionDecision)}
          </span>
        )}
        {operatorState.verificationState && (
          <span class={`inline-flex items-center rounded-full px-2.5 py-1 font-medium ${verificationColor[String(operatorState.verificationState)] ?? "bg-muted text-muted-foreground"}`}>
            verify:{String(operatorState.verificationState)}
          </span>
        )}
        {operatorState.observationState && (
          <span class="inline-flex items-center rounded-full bg-violet-100 px-2.5 py-1 font-medium text-violet-800 dark:bg-violet-900/30 dark:text-violet-300">
            obs:{String(operatorState.observationState)}
          </span>
        )}
        {operatorState.duplicateKind && (
          <span class="inline-flex items-center rounded-full bg-cyan-100 px-2.5 py-1 font-medium text-cyan-800 dark:bg-cyan-900/30 dark:text-cyan-300">
            dup:{String(operatorState.duplicateKind)}
          </span>
        )}
        <span class="inline-flex items-center rounded-full bg-secondary px-2.5 py-1 font-medium text-secondary-foreground">
          raw:{String(signal_candidate.processing_state ?? "raw")}
        </span>
        <span class="inline-flex items-center rounded-full bg-muted px-2.5 py-1 font-medium">
          enrich:{String(signal_candidate.enrichment_state ?? "pending")}
        </span>
        {signal_candidate.system_feed_decision && (
          <span class={`inline-flex items-center rounded-full px-2.5 py-1 font-medium ${systemFeedColor[String(signal_candidate.system_feed_decision)] ?? "bg-muted text-muted-foreground"}`}>
            compat:{String(signal_candidate.system_feed_decision)}
          </span>
        )}
        <span class="inline-flex items-center rounded-full bg-muted px-2.5 py-1 font-medium text-muted-foreground">
          {operatorState.selectionSummary}
        </span>
      </div>
      <h1 class="mt-4 text-2xl font-semibold tracking-tight">{String(signal_candidate.title ?? "Untitled signal_candidate")}</h1>
      <p class="mt-2 max-w-3xl text-sm leading-6 text-muted-foreground">{String(signal_candidate.lead ?? "")}</p>
      <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-4">
        <div class={ADMIN_BACKGROUND_TILE_CLASS}>
          <p class="text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Source</p>
          <p class="mt-2 font-medium">{String(signal_candidate.source_name ?? signal_candidate.channel_name ?? "Unknown")}</p>
          <p class="mt-1 text-sm text-muted-foreground">Author: {String(signal_candidate.author_name ?? signal_candidate.extracted_author ?? "Unknown")}</p>
        </div>
        <div class={ADMIN_BACKGROUND_TILE_CLASS}>
          <p class="text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Published</p>
          <p class="mt-2 font-medium">{formatTimestamp(signal_candidate.extracted_published_at ?? signal_candidate.published_at)}</p>
          <p class="mt-1 text-sm text-muted-foreground">Read time: {formatReadTime(signal_candidate.read_time_seconds ?? signal_candidate.extracted_ttr_seconds)}</p>
        </div>
        <div class={ADMIN_BACKGROUND_TILE_CLASS}>
          <p class="text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Canonical Doc</p>
          <p class="mt-2 font-medium">{signal_candidate.canonical_document_id ? shortId(signal_candidate.canonical_document_id) : "Pending"}</p>
          <p class="mt-1 text-sm text-muted-foreground">
            {signal_candidate.canonical_domain ? `${String(signal_candidate.canonical_domain)} · ` : ""}{String(signal_candidate.canonical_observation_count ?? 0)} observation{Number(signal_candidate.canonical_observation_count ?? 0) === 1 ? "" : "s"}
          </p>
        </div>
        <div class={ADMIN_BACKGROUND_TILE_CLASS}>
          <p class="text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Story Cluster</p>
          <p class="mt-2 font-medium">{signal_candidate.story_cluster_id ? shortId(signal_candidate.story_cluster_id) : "—"}</p>
          <p class="mt-1 text-sm text-muted-foreground">
            {String(signal_candidate.story_cluster_verification_state ?? "unverified")} · {String(signal_candidate.story_cluster_source_family_count ?? 0)} source families
          </p>
        </div>
      </div>
      <div class={`mt-4 ${ADMIN_BACKGROUND_TILE_CLASS} text-sm text-muted-foreground`}>
        This page is an operator view for one editorial signal_candidate observation. Canonical document ownership, story-cluster verification, and final selection are the durable selection truth; <code class="rounded bg-muted px-1 py-0.5">processing_state</code> stays here as raw pipeline telemetry.
      </div>
      <div class={`mt-4 rounded-2xl border p-4 text-sm ${
        operatorGuidance.tone === "positive"
          ? "border-emerald-200 bg-emerald-50/70 text-emerald-900 dark:border-emerald-900/40 dark:bg-emerald-950/20 dark:text-emerald-200"
          : operatorGuidance.tone === "warning"
            ? "border-amber-200 bg-amber-50/70 text-amber-900 dark:border-amber-900/40 dark:bg-amber-950/20 dark:text-amber-200"
            : "border-border bg-background text-muted-foreground"
      }`}>
        {operatorGuidance.summary}
      </div>
    </div>

    <section class={ADMIN_SECTION_CARD_CLASS}>
      <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
          <h2 class="text-base font-semibold">Analysis</h2>
          <p class="mt-1 text-sm text-muted-foreground">
            {analysisEntities.length} entities · {analysisLabels.length} labels
          </p>
        </div>
        {analysisFilter && (
          <span class="rounded-full bg-secondary px-2.5 py-1 text-xs font-medium text-secondary-foreground">
            gate:{String(analysisFilter.decision ?? "pending")}
          </span>
        )}
      </div>
      <div class="mt-4 flex flex-wrap gap-2">
        {analysisEntities.slice(0, 16).map((entity) => (
          <span class="rounded-full bg-muted px-2.5 py-1 text-xs font-medium">
            {String(entity.entity_type ?? "ENTITY")} · {String(entity.entity_text ?? "")}
          </span>
        ))}
        {analysisEntities.length === 0 && <p class="text-sm text-muted-foreground">No persisted entities yet.</p>}
      </div>
    </section>

    <div class="grid gap-6 xl:grid-cols-[1.4fr_0.6fr]">
      <section class={ADMIN_SECTION_CARD_CLASS}>
        <div class="mb-4">
          <h2 class="text-base font-semibold">Content preview</h2>
          <p class="mt-1 text-sm text-muted-foreground">
            Editorial maintenance detail for the underlying signal_candidate observation. Public readers now use the universal <code class="rounded bg-muted px-1 py-0.5">/content/&lt;contentItemId&gt;</code> surface, while operators should reason from canonical, verification, and final-selection fields below.
          </p>
        </div>
        {signalCandidateHtml ? (
          <article
            class="prose prose-neutral max-w-none prose-headings:text-foreground prose-a:text-primary dark:prose-invert"
            set:html={signalCandidateHtml}
          />
        ) : (
          <pre class="whitespace-pre-wrap text-sm leading-6 text-foreground">{String(signal_candidate.body ?? "")}</pre>
        )}
      </section>

      <div class="space-y-6">
        <section class={ADMIN_SECTION_CARD_CLASS}>
          <div class="mb-4">
            <h2 class="text-base font-semibold">Pipeline truth</h2>
            <p class="mt-1 text-sm text-muted-foreground">
              Current operator-facing cutover view across observation, canonical document, story cluster, verification, and final selection.
            </p>
          </div>
          <dl class="grid gap-3 text-sm">
            <div>
              <dt class="text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Selection source</dt>
              <dd class="mt-1 text-foreground">{String(operatorState.selectionSource)}</dd>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Canonical document</dt>
              <dd class="mt-1 text-foreground">
                {signal_candidate.canonical_document_id ? String(signal_candidate.canonical_document_id) : "Not materialized yet"}
              </dd>
              {canonicalHref && (
                <a href={canonicalHref} target="_blank" rel="noopener noreferrer" class="mt-1 inline-block break-all text-xs text-primary hover:underline">
                  {canonicalHref}
                </a>
              )}
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Verification</dt>
              <dd class="mt-1 text-foreground">
                Final: {String(signal_candidate.final_selection_verification_state ?? "—")} · Canonical: {String(signal_candidate.canonical_verification_state ?? "—")} · Cluster: {String(signal_candidate.story_cluster_verification_state ?? "—")}
              </dd>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Story cluster</dt>
              <dd class="mt-1 text-foreground">
                {signal_candidate.story_cluster_id ? String(signal_candidate.story_cluster_id) : "Not clustered yet"}
              </dd>
              <p class="mt-1 text-xs text-muted-foreground">
                {String(signal_candidate.story_cluster_title ?? "—")} · {String(signal_candidate.story_cluster_document_count ?? 0)} canonical docs · {String(signal_candidate.story_cluster_corroboration_count ?? 0)} corroborations
              </p>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Observation state</dt>
              <dd class="mt-1 text-foreground">
                {String(signal_candidate.observation_state ?? "—")} · duplicate: {String(signal_candidate.duplicate_kind ?? "—")}
              </dd>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Selection decision</dt>
              <dd class="mt-1 text-foreground">
                Final: {String(signal_candidate.final_selection_decision ?? "—")} · Compatibility: {String(signal_candidate.system_feed_decision ?? "—")}
              </dd>
              <p class="mt-1 text-xs text-muted-foreground">
                {operatorState.selectionSummary}
                {operatorState.selectionReason ? ` · reason:${operatorState.selectionReason}` : ""}
                {operatorState.holdCount > 0 ? ` · hold:${operatorState.holdCount}` : ""}
                {operatorState.llmReviewPendingCount > 0 ? ` · pending review:${operatorState.llmReviewPendingCount}` : ""}
              </p>
            </div>
          </dl>
        </section>

        <section class={ADMIN_SECTION_CARD_CLASS}>
          <div class="mb-4">
            <h2 class="text-base font-semibold">Selection diagnostics</h2>
            <p class="mt-1 text-sm text-muted-foreground">
              Generic profile-driven summary of the current explain payload. This is meant for tuning and review, not as a domain-specific template debugger.
            </p>
          </div>
          <dl class="grid gap-3 text-sm">
            <div>
              <dt class="text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Policy summary</dt>
              <dd class="mt-1 text-foreground">
                {selectionDiagnostics.selectionSummary}
                {selectionDiagnostics.selectionReason ? ` · ${selectionDiagnostics.selectionReason}` : ""}
              </dd>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Selection mode</dt>
              <dd class="mt-1 text-foreground">
                {selectionDiagnostics.selectionMode} · source: {selectionDiagnostics.source}
              </dd>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Downstream blocker</dt>
              <dd class="mt-1 text-foreground">
                {String(selectionDiagnostics.downstreamLossBucket ?? "—")} · stage: {String(selectionDiagnostics.selectionBlockerStage ?? "—")}
              </dd>
              <p class="mt-1 text-xs text-muted-foreground">
                {String(selectionDiagnostics.selectionBlockerReason ?? "No blocker reason recorded.")}
              </p>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Filter coverage</dt>
              <dd class="mt-1 text-foreground">
                system criteria: {selectionDiagnostics.systemCriterionRows} · user interests: {selectionDiagnostics.userInterestRows}
              </dd>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Filter outcomes</dt>
              <dd class="mt-1 text-foreground">
                match: {selectionDiagnostics.matchedRows} · no-match: {selectionDiagnostics.noMatchRows} · gray-zone: {selectionDiagnostics.grayZoneRows} · technical filtered: {selectionDiagnostics.technicalFilteredOutRows}
              </dd>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Follow-up activity</dt>
              <dd class="mt-1 text-foreground">
                hold count: {selectionDiagnostics.holdCount} · review pending: {selectionDiagnostics.llmReviewPendingCount} · llm review rows: {selectionDiagnostics.llmReviewRows} · notifications: {selectionDiagnostics.notificationRows}
              </dd>
              <p class="mt-1 text-xs text-muted-foreground">
                {`verification: ${JSON.stringify(selectionDiagnostics.verificationSignalSummary ?? {})}`}
              </p>
            </div>
          </dl>
        </section>

        <section class={ADMIN_SECTION_CARD_CLASS}>
          <div class="mb-4">
            <h2 class="text-base font-semibold">Extraction metadata</h2>
            <p class="mt-1 text-sm text-muted-foreground">
              Persisted signal_candidate enrichment fields exposed for operator debugging.
            </p>
          </div>
          <dl class="grid gap-3 text-sm">
            <div>
              <dt class="text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Description</dt>
              <dd class="mt-1 text-foreground">{String(signal_candidate.extracted_description ?? "—")}</dd>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Image URL</dt>
              <dd class="mt-1 break-all text-foreground">{String(signal_candidate.extracted_image_url ?? "—")}</dd>
            </div>
            <div>
              <dt class="text-[11px] uppercase tracking-[0.16em] text-muted-foreground">Favicon URL</dt>
              <dd class="mt-1 break-all text-foreground">{String(signal_candidate.extracted_favicon_url ?? "—")}</dd>
            </div>
          </dl>
        </section>

        <section class={ADMIN_SECTION_CARD_CLASS}>
          <div class="mb-4">
            <h2 class="text-base font-semibold">Media assets</h2>
            <p class="mt-1 text-sm text-muted-foreground">
              `signal_candidate_media_assets` owned by the enrichment path for this observation row.
            </p>
          </div>
          {mediaAssets.length === 0 ? (
            <p class="text-sm text-muted-foreground">No persisted media assets.</p>
          ) : (
            <div class="space-y-3">
              {mediaAssets.map((asset) => (
                <div class={ADMIN_BACKGROUND_TILE_CLASS}>
                  <p class="text-sm font-medium text-foreground">
                    {String(asset.media_kind ?? "asset")} · {String(asset.storage_kind ?? "external_url")}
                  </p>
                  <p class="mt-1 break-all text-xs text-muted-foreground">{String(asset.source_url ?? "—")}</p>
                </div>
              ))}
            </div>
          )}
        </section>
      </div>
    </div>

    <details class={`group ${ADMIN_SECTION_CARD_CLASS}`}>
      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 text-sm font-semibold text-foreground [&::-webkit-details-marker]:hidden">
        <span>Raw enrichment debug</span>
        <span class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-border bg-background text-muted-foreground transition group-open:rotate-180">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </span>
      </summary>
      <pre class="mt-4 overflow-x-auto rounded-2xl bg-background p-4 text-xs leading-6 text-foreground">{JSON.stringify(signal_candidate.enrichment_debug ?? {}, null, 2)}</pre>
    </details>
  </div>
</AdminShell>

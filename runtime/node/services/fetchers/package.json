{
  "name": "@signalops/fetchers",
  "private": true,
  "type": "module",
  "scripts": {
    "signal-candidate-yield:diagnostics": "node ../../../../build/node/services/fetchers/cli/signal-candidate-yield-diagnostics.mjs",
    "signal-candidate-yield:remediate": "node ../../../../build/node/services/fetchers/cli/signal-candidate-yield-remediate.mjs",
    "build": "tsc -p tsconfig.json --noEmit && pnpm build:runtime",
    "build:runtime": "node ../../../../infra/tooling/build-node-runtime.mjs --service=fetchers",
    "replay:website-projections": "node ../../../../build/node/services/fetchers/cli/replay-website-projections.mjs",
    "test:channel-auth-smoke": "NODE_PATH=./node_modules node --import tsx ../../../../infra/scripts/fetchers/test-channel-auth-smoke.ts",
    "test:feed-ingress-adapters-smoke": "NODE_PATH=./node_modules node --import tsx ../../../../infra/scripts/fetchers/test-feed-ingress-adapters-smoke.ts",
    "test:hard-sites-smoke": "NODE_PATH=./node_modules node --import tsx ../../../../infra/scripts/fetchers/test-hard-sites-smoke.ts",
    "test:provider-universality-smoke": "NODE_PATH=./node_modules node --import tsx ../../../../infra/scripts/fetchers/test-provider-universality-smoke.ts",
    "run:once": "node ../../../../build/node/services/fetchers/cli/run-once.mjs",
    "start": "node ../../../../build/node/services/fetchers/main.mjs",
    "test:enrichment-smoke": "NODE_PATH=./node_modules node --import tsx ../../../../infra/scripts/fetchers/test-enrichment-smoke.ts",
    "test:rss-smoke": "NODE_PATH=./node_modules node --import tsx ../../../../infra/scripts/fetchers/test-rss-smoke.ts",
    "test:website-smoke": "NODE_PATH=./node_modules node --import tsx ../../../../infra/scripts/fetchers/test-website-smoke.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@extractus/article-extractor": "8.0.20",
    "@extractus/oembed-extractor": "4.0.9",
    "@signalops/contracts": "workspace:*",
    "duck-duck-scrape": "2.2.7",
    "fast-xml-parser": "5.8.0",
    "fastify": "5.8.5",
    "feedsmith": "2.9.4",
    "htmlparser2": "12.0.0",
    "imapflow": "1.3.3",
    "pdfjs-dist": "6.0.227",
    "pg": "8.20.0",
    "playwright": "1.58.2"
  }
}

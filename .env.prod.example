# Copy to .env.prod on the beta host and replace every placeholder.
# This file is documentation; pnpm check:prod-env intentionally fails on placeholders.

POSTGRES_DB=signalops
POSTGRES_USER=signalops
POSTGRES_PASSWORD=replace-me-strong-db-password

RELAY_PORT=4000
FETCHERS_PORT=4100
API_PORT=8000
WEB_PORT=4321
ADMIN_PORT=4322
MCP_PORT=4300
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

PYTHON_APP_UID=10001
PYTHON_APP_GID=10001

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=20
FETCHERS_POLL_INTERVAL_MS=5000
FETCHERS_BATCH_SIZE=100
FETCHERS_CONCURRENCY=4
FETCHERS_REQUEST_TIMEOUT_MS=10000
FETCHERS_USER_AGENT=SignalOpsFetchers/0.1 (+https://signalops.example)
FETCHERS_ACQUISITION_PRIVATE_HOST_ALLOWLIST=
FETCHERS_INTERNAL_BASE_URL=http://fetchers:4100
FETCHERS_INTERNAL_TIMEOUT_SECONDS=30

EMBEDDING_MODEL=hash://deterministic/384
EMBEDDING_BACKEND=hash
EMBEDDING_HASH_DIMENSIONS=384
MODEL_CACHE_DIR=/workspace/data/models
HNSW_INDEX_ROOT=/workspace/data/indices
HNSW_SNAPSHOT_ROOT=/workspace/data/snapshots

SIGNALOPS_API_BASE_URL=http://api:8000
SIGNALOPS_PUBLIC_API_BASE_URL=https://api.signalops.example
SIGNALOPS_WEB_APP_BASE_URL=https://signalops.example/
SIGNALOPS_ADMIN_APP_BASE_URL=https://signalops.example/admin/
SIGNALOPS_COOKIE_SECURE_POLICY=always
SIGNALOPS_API_CONTENT_AUTH_REQUIRED=true
SIGNALOPS_WEB_TEST_AUTH_ENABLED=false
SIGNALOPS_WEB_TEST_AUTH_EMAIL=
SIGNALOPS_WEB_GOOGLE_ALLOWED_DOMAIN=
SIGNALOPS_WEB_GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com

FIREBASE_PROJECT_ID=replace-me
FIREBASE_WEB_API_KEY=replace-me
FIREBASE_CLIENT_CONFIG={"apiKey":"replace-me","projectId":"replace-me","authDomain":"replace-me.firebaseapp.com"}
FIREBASE_ADMIN_CREDENTIALS={"project_id":"replace-me","client_email":"replace-me","private_key":"replace-me-with-escaped-newline-private-key"}
ADMIN_ALLOWLIST_EMAILS=admin@example.com

GEMINI_API_KEY=replace-me
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LLM_INPUT_COST_PER_MILLION_USD=0.25
LLM_OUTPUT_COST_PER_MILLION_USD=1.50
LLM_REVIEW_ENABLED=1
LLM_REVIEW_MONTHLY_BUDGET_CENTS=500
LLM_REVIEW_BUDGET_EXHAUST_ACCEPT_GRAY_ZONE=0

DISCOVERY_ENABLED=0
DISCOVERY_CRON=0 */6 * * *
DISCOVERY_BUDGET_CENTS_DEFAULT=500
DISCOVERY_MAX_HYPOTHESES_PER_RUN=20
DISCOVERY_MAX_SOURCES_DEFAULT=20
DISCOVERY_AUTO_APPROVE_THRESHOLD=
DISCOVERY_SEARCH_PROVIDER=ddgs
DISCOVERY_SEARCH_PROVIDERS=
DISCOVERY_DDGS_BACKEND=auto
DISCOVERY_DDGS_REGION=us-en
DISCOVERY_DDGS_SAFESEARCH=moderate
DISCOVERY_BRAVE_API_KEY=
DISCOVERY_SERPER_API_KEY=
DISCOVERY_GEMINI_API_KEY=
DISCOVERY_GEMINI_MODEL=gemini-3.5-flash
DISCOVERY_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
DISCOVERY_LLM_INPUT_COST_PER_MILLION_USD=1.50
DISCOVERY_LLM_OUTPUT_COST_PER_MILLION_USD=9.00
DISCOVERY_MONTHLY_BUDGET_CENTS=500

TELEGRAM_BOT_TOKEN=
EMAIL_DIGEST_SMTP_URL=smtps://smtp.example.com:465
EMAIL_DIGEST_FROM=alerts@signalops.example
WORKER_ENABLE_USER_DIGEST_SCHEDULER=1
WORKER_USER_DIGEST_POLL_INTERVAL_SECONDS=30

WORKER_SEQUENCE_RUNNER_CONCURRENCY=4
WORKER_SEQUENCE_RUNNER_LOCK_DURATION_MS=300000
WORKER_SEQUENCE_RUNNER_STALLED_INTERVAL_MS=300000

WEB_PUSH_VAPID_PUBLIC_KEY=replace-me
WEB_PUSH_VAPID_PRIVATE_KEY=replace-me
WEB_PUSH_VAPID_SUBJECT=mailto:alerts@signalops.example
PUBLIC_API_SIGNING_KEY=replace-me-at-least-32-characters
APP_SECRET=replace-me-at-least-32-characters

EMAIL_IMAP_PROD_RUNTIME_REQUIRED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
